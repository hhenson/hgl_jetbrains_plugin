<idea-plugin>
    <id>io.github.hhenson.hgl</id>
    <name>HGL</name>
    <vendor url="https://github.com/hhenson">Howard Henson</vendor>

    <description><![CDATA[
    Language support for HGL, the temporal programming language:
    syntax highlighting, brace matching, comments, code folding, structure
    view, completion and navigation across <code>.hgl</code> modules, parts and applications.
    The language is specified in
    <a href="https://github.com/hhenson/hgl_spec">hgl_spec</a>.
    ]]></description>

    <!-- Editing is available across IDEs. Native debugging is optional. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.platform.testRunner</depends>

    <depends optional="true" config-file="hgl-compdb.xml">com.intellij.clion-compdb</depends>
    <content>
        <module name="io.github.hhenson.hgl.debug"/>
    </content>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="HGL"
                  implementationClass="io.github.hhenson.hgl.HglFileType"
                  fieldName="INSTANCE"
                  language="HGL"
                  extensions="hgl"/>
        <fileType name="HGL Debug Source"
                  implementationClass="io.github.hhenson.hgl.HglDebugSourceFileType"
                  fieldName="INSTANCE"
                  patterns="*.hgl.source"/>
        <lang.parserDefinition language="HGL"
                               implementationClass="io.github.hhenson.hgl.parser.HglParserDefinition"/>
        <lang.syntaxHighlighterFactory language="HGL"
                                       implementationClass="io.github.hhenson.hgl.highlighting.HglSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="io.github.hhenson.hgl.highlighting.HglColorSettingsPage"/>
        <annotator language="HGL" implementationClass="io.github.hhenson.hgl.highlighting.HglAnnotator"/>
        <annotator language="HGL" implementationClass="io.github.hhenson.hgl.diagnostics.HglCompilerAnnotator"/>
        <fileDocumentManagerListener implementation="io.github.hhenson.hgl.diagnostics.HglSaveListener"/>
        <notificationGroup id="HGL compiler" displayType="BALLOON"/>
        <lang.braceMatcher language="HGL" implementationClass="io.github.hhenson.hgl.editor.HglBraceMatcher"/>
        <lang.commenter language="HGL" implementationClass="io.github.hhenson.hgl.editor.HglCommenter"/>
        <lang.foldingBuilder language="HGL" implementationClass="io.github.hhenson.hgl.editor.HglFoldingBuilder"/>
        <lang.psiStructureViewFactory language="HGL"
                                      implementationClass="io.github.hhenson.hgl.structure.HglStructureViewFactory"/>
        <lang.findUsagesProvider language="HGL" implementationClass="io.github.hhenson.hgl.reference.HglFindUsagesProvider"/>
        <lang.refactoringSupport language="HGL" implementationClass="io.github.hhenson.hgl.reference.HglRefactoringSupportProvider"/>
        <completion.contributor language="HGL"
                                implementationClass="io.github.hhenson.hgl.completion.HglCompletionContributor"/>
        <platform.backend.documentation.linkHandler implementation="io.github.hhenson.hgl.documentation.HglDocLinkHandler"/>
        <platform.backend.documentation.targetProvider
            implementation="io.github.hhenson.hgl.documentation.HglDocumentationTargetProvider"/>
        <platform.backend.documentation.psiTargetProvider
            implementation="io.github.hhenson.hgl.documentation.HglDocumentationTargetProvider"/>
        <directoryProjectGenerator implementation="io.github.hhenson.hgl.project.HglProjectGenerator"/>
        <postStartupActivity implementation="io.github.hhenson.hgl.run.HglTargetsStartup"/>
        <configurationType implementation="io.github.hhenson.hgl.run.HglTestType"/>
        <configurationType implementation="io.github.hhenson.hgl.run.HglScopedTestType"/>
        <configurationType implementation="io.github.hhenson.hgl.run.HglApplicationType"/>
        <runConfigurationProducer implementation="io.github.hhenson.hgl.run.HglTestProducer"/>
        <runConfigurationProducer implementation="io.github.hhenson.hgl.run.HglApplicationProducer"/>
        <runLineMarkerContributor language="HGL" implementationClass="io.github.hhenson.hgl.run.HglRunGutter"/>
        <codeInsight.lineMarkerProvider language="HGL" implementationClass="io.github.hhenson.hgl.reference.HglOperatorGutter"/>
        <projectConfigurable parentId="build" id="hgl.test.runner" displayName="HGL"
                             instance="io.github.hhenson.hgl.run.HglTestSettingsPage"/>
        <fileBasedIndex implementation="io.github.hhenson.hgl.reference.HglModuleIndex"/>
        <fileBasedIndex implementation="io.github.hhenson.hgl.reference.HglImplementationIndex"/>
    </extensions>
    <actions>
        <action id="HGL.RunTests" class="io.github.hhenson.hgl.run.HglRunTestsAction"
                text="Run HGL Tests" description="Run ordinary tests in this HGL file or folder" icon="AllIcons.RunConfigurations.TestState.Run">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="ProjectViewPopupMenuRunGroup"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="first"/>
        </action>
        <action id="HGL.RunIntegrationTests" class="io.github.hhenson.hgl.run.HglRunIntegrationTestsAction"
                text="Run HGL Integration Tests" description="Run integration tests in this HGL file or folder" icon="AllIcons.RunConfigurations.TestState.Run">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="HGL.RunTests"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="after" relative-to-action="HGL.RunTests"/>
        </action>
        <group id="HGL.BuildModes" text="Build HGL Project" popup="true" icon="AllIcons.Actions.Compile">
            <action id="HGL.Build" class="io.github.hhenson.hgl.project.HglBuildAction"
                    text="Release" description="Build the project with the compiler's release settings"/>
            <action id="HGL.BuildDebug" class="io.github.hhenson.hgl.project.HglDebugBuildAction"
                    text="Debug" description="Build the project with native debug symbols"/>
            <separator/>
            <action id="HGL.Rebuild" class="io.github.hhenson.hgl.project.HglRebuildAction"
                    text="Clean and Rebuild Release" description="Clear the release build outputs and rebuild the project"/>
            <action id="HGL.RebuildDebug" class="io.github.hhenson.hgl.project.HglDebugRebuildAction"
                    text="Clean and Rebuild Debug" description="Clear the debug build outputs and rebuild with native debug symbols"/>
            <add-to-group group-id="BuildMenu" anchor="first"/>
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
        </group>
        <action id="HGL.GenerateDocumentation" class="io.github.hhenson.hgl.documentation.HglGenerateDocs"
                text="Generate HGL Documentation" description="Generate HTML and JSON documentation from the HGL source roots"
                icon="AllIcons.Actions.Preview">
            <add-to-group group-id="BuildMenu" anchor="last"/>
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
