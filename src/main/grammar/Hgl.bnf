/* HGL syntax. Authority: spec/hgl_spec, the editor baseline. */
{
  parserClass="io.github.hhenson.hgl.parser.HglParser"
  parserUtilClass="io.github.hhenson.hgl.parser.HglParserUtil"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Hgl"
  psiImplClassSuffix="Impl"
  psiPackage="io.github.hhenson.hgl.psi"
  psiImplPackage="io.github.hhenson.hgl.psi.impl"

  elementTypeHolderClass="io.github.hhenson.hgl.psi.HglTypes"
  elementTypeClass="io.github.hhenson.hgl.psi.HglElementType"
  tokenTypeClass="io.github.hhenson.hgl.psi.HglTokenType"

  generateTokenAccessors=true

  extends(".*_expr")=expr

  implements("function_decl|native_function_decl|operator_decl|struct_decl|enum_decl|enum_member|native_type_decl|native_property|constant_decl|test_decl|configuration_parameter|parameter|function_type_parameter|generic_parameter|local_decl|state_decl|cache_decl|for_binding|struct_member|import_item|use_alias|anonymous_parameter|inject_item")="io.github.hhenson.hgl.psi.HglNamedElement"
  mixin("function_decl|native_function_decl|operator_decl|struct_decl|enum_decl|enum_member|native_type_decl|native_property|constant_decl|test_decl|configuration_parameter|parameter|function_type_parameter|generic_parameter|local_decl|state_decl|cache_decl|for_binding|struct_member|use_alias|anonymous_parameter|inject_item")="io.github.hhenson.hgl.psi.impl.HglNamedElementImpl"
  mixin("named_argument")="io.github.hhenson.hgl.psi.impl.HglNamedArgumentMixin"
  mixin("import_item")="io.github.hhenson.hgl.psi.impl.HglImportItemMixin"
  mixin("qualified_name")="io.github.hhenson.hgl.psi.impl.HglQualifiedNameMixin"
  mixin("member_name")="io.github.hhenson.hgl.psi.impl.HglMemberNameMixin"
  mixin("module_path")="io.github.hhenson.hgl.psi.impl.HglModulePathMixin"

  tokens=[
    ENUM_KW='enum'
    BYTES_KW='bytes'
    ANY_KW='any'
    RESULT_KW='result'
    ERROR_KW='error'
    DICT_KW='dict'
    QUESTION='?'
    SPACESHIP='<=>'
    FLOOR_SLASH_EQ='//='
    PERCENT_EQ='%='
    AT='@'
    SWITCH_KW='switch'
    CASE_KW='case'
    DEFAULT_KW='default'
    RAISES_KW='raises'
    TYPE_KW='type'
    NEWLINE='regexp:\n'
    LINE_COMMENT='regexp:#[^\n]*'
    DOC_COMMENT='regexp:/\*\*.*\*/'
    BLOCK_COMMENT='regexp:/\*.*\*/'

    IDENTIFIER='regexp:[A-Za-z_][A-Za-z0-9_]*'
    PLACEHOLDER='_'
    INT_LITERAL='regexp:[0-9]+'
    FLOAT_LITERAL='regexp:[0-9]+\.[0-9]+'
    STRING_LITERAL='regexp:"[^"]*"'
    TEMPORAL_LITERAL='regexp:@[^ ]+'

    // Reserved words from the pinned source-text.md; const remains contextual.
    MODULE_KW='module'
    PART_KW='part'
    USE_KW='use'
    AS_KW='as'
    EXPORT_KW='export'
    ABSTRACT_KW='abstract'
    IMPL_KW='impl'
    INSTANTIATE_KW='instantiate'
    OPERATOR_KW='operator'
    FN_KW='fn'
    STRUCT_KW='struct'
    CONST_KW='const'
    REQUIRES_KW='requires'
    IS_KW='is'
    LET_KW='let'
    VAR_KW='var'
    STATE_KW='state'
    CACHE_KW='cache'
    INJECT_KW='inject'
    RETURN_KW='return'
    IF_KW='if'
    ELSE_KW='else'
    START_KW='start'
    WHEN_KW='when'
    STOP_KW='stop'
    FOR_KW='for'
    WHILE_KW='while'
    YIELD_KW='yield'
    TEST_KW='test'
    ASSERT_KW='assert'
    EVAL_KW='eval'
    RUN_KW='run'
    TRUE_KW='true'
    FALSE_KW='false'
    NULL_KW='null'
    BOOL_KW='bool'
    I64_KW='i64'
    F64_KW='f64'
    STR_KW='str'
    DATE_KW='date'
    TIME_KW='time'
    DATETIME_KW='datetime'
    DURATION_KW='duration'
    CIVIL_DATETIME_KW='civil_datetime'
    ZONED_DATETIME_KW='zoned_datetime'
    ZONED_TIME_KW='zoned_time'
    TIMEZONE_KW='timezone'

// Contextual words are remapped by the parser; container names below are reserved.
    IN_KW='in'
    NATIVE_KW='native'
    EACH_KW='each'
    PROPERTIES_KW='properties'
    UNBOUNDED_KW='unbounded'
    DELTA_KW='delta'
    ATOMIC_KW='atomic'
    TUPLE_KW='tuple'
    LIST_KW='list'
    SET_KW='set'
    ROLLING_WINDOW_KW='rolling_window'
    ENDPOINT_KW='endpoint'
    TENOR_KW='tenor'
    APPLICATION_KW='application'
    WITHOUT_KW='without'
    INTEGRATION_TEST_KW='integration_test'
    TIMEOUT_KW='timeout'
    SUPPRESS_WARNING_KW='suppress_warning'
    REF_KW='ref'
    SIGNAL_KW='signal'

    LPAREN='('
    RPAREN=')'
    LBRACE='{'
    RBRACE='}'
    LBRACKET='['
    RBRACKET=']'
    LT='<'
    GT='>'
    COMMA=','
    COLON=':'
    COLONCOLON='::'
    DOT='.'
    ELLIPSIS='...'
    RANGE='..<'
    ARROW='->'
    FAT_ARROW='=>'
    EQ='='
    PLUS_EQ='+='
    MINUS_EQ='-='
    STAR_EQ='*='
    SLASH_EQ='/='
    EQEQ='=='
    NEQ='!='
    LE='<='
    GE='>='
    PLUS='+'
    MINUS='-'
    STAR='*'
    SLASH='/'
    FLOOR_SLASH='//'
    PERCENT='%'
    BANG='!'
    ANDAND='&&'
    OROR='||'
    SEMICOLON=';'
  ]
}

// ---------------------------------------------------------------------------
// Compilation unit
// ---------------------------------------------------------------------------

hglFile ::= nls module_line? top_item*

private module_line ::= (module_decl | application_decl) &(NEWLINE | <<eof>>) {pin=1}
private top_item ::= !<<eof>> (NEWLINE | declaration_item)
private declaration_item ::= !NEWLINE declaration_body {pin=1 recoverWhile=line_recover}
private declaration_body ::= declaration &(NEWLINE | <<eof>>) {pin=1}
// Recovery stops at the line end or at a word that can only start a
// declaration, so a broken declaration never swallows the next one.
private line_recover ::= !(NEWLINE | USE_KW | FN_KW | OPERATOR_KW | INSTANTIATE_KW | STRUCT_KW | ENUM_KW
                          | TEST_KW | EXPORT_KW | IMPL_KW | ABSTRACT_KW | CONST_KW | MODULE_KW | <<isKw "NATIVE_KW">>)

private nls ::= NEWLINE*
// LEX-5: a body may start one logical line after its header.
private body_gap ::= continuation_gap &LBRACE
private continuation_gap ::= nls <<continuesLine>>
private comma_sep ::= nls COMMA nls
private trailing_comma ::= nls COMMA
private meta list_of ::= <<p>> (comma_sep <<p>>)* trailing_comma?
private grouped_expr ::= <<inGroup expr>>

module_decl ::= MODULE_KW module_path (PART_KW ident)? {pin=1}
application_decl ::= <<kw "APPLICATION_KW">> module_path {pin=1}
module_path ::= path_segment (nls DOT nls path_segment)*
private path_segment ::= &IDENTIFIER member_name

private declaration ::= use_decl
              | constant_decl
              | native_type_decl
              | enum_decl
              | native_function_decl
              | function_decl
              | operator_decl
              | instantiate_decl
              | struct_decl
              | test_context
              | test_decl
              | inject_decl
              | run_statement
              | store_call

constant_decl ::= EXPORT_KW? <<kw "CONST_KW">> ident COLON nls type initializer {pin=3}
run_statement ::= (EVAL_KW | RUN_KW) harness_target
store_call ::= simple_name call_suffix

use_decl ::= USE_KW module_path (import_set | use_alias) {pin=1}
import_set ::= COLONCOLON LBRACE nls <<list_of import_item>>? nls RBRACE {pin=2}
import_item ::= ident
use_alias ::= AS_KW ident {pin=1}


// LEX-9: declarations use identifiers; members and labels also admit reserved words.
ident ::= IDENTIFIER
member_name ::= ident | keyword_name
private keyword_name ::= ENUM_KW | RESULT_KW | ERROR_KW | DICT_KW | ATOMIC_KW | TUPLE_KW | LIST_KW | SET_KW | ROLLING_WINDOW_KW | ENDPOINT_KW | REF_KW | SIGNAL_KW | DELTA_KW | MODULE_KW | PART_KW | USE_KW | AS_KW | EXPORT_KW | ABSTRACT_KW | IMPL_KW
                       | INSTANTIATE_KW | OPERATOR_KW | FN_KW | STRUCT_KW
                       | REQUIRES_KW | IS_KW | LET_KW | VAR_KW | STATE_KW | CACHE_KW | INJECT_KW
                       | RETURN_KW | IF_KW | ELSE_KW | SWITCH_KW | START_KW | WHEN_KW | STOP_KW | FOR_KW
                       | WHILE_KW | YIELD_KW
                       | TEST_KW | ASSERT_KW | RAISES_KW | EVAL_KW | RUN_KW | TRUE_KW | FALSE_KW | NULL_KW
                       | scalar_type_keyword
private scalar_type_keyword ::= TENOR_KW | BYTES_KW | ANY_KW | BOOL_KW | I64_KW | F64_KW | STR_KW | DATE_KW | TIME_KW | DATETIME_KW
                              | DURATION_KW | CIVIL_DATETIME_KW | ZONED_DATETIME_KW | ZONED_TIME_KW
                              | TIMEZONE_KW

qualified_name ::= ident (COLONCOLON ident)?
private simple_name ::= !(IDENTIFIER COLONCOLON) qualified_name

// ---------------------------------------------------------------------------
// Declarations
// ---------------------------------------------------------------------------

struct_decl ::= EXPORT_KW? ABSTRACT_KW? STRUCT_KW ident generic_parameters? struct_parents? opt_requires struct_body {pin=3}
struct_parents ::= COLON nls <<list_of type>> {pin=1}
struct_body ::= body_gap LBRACE struct_body_item* RBRACE {pin=2}
private struct_body_item ::= !RBRACE (NEWLINE | struct_member_item)
private struct_member_item ::= !(NEWLINE | RBRACE) struct_member_body {pin=1 recoverWhile=statement_recover}
private struct_member_body ::= struct_member &(NEWLINE | RBRACE) {pin=1}
struct_member ::= member_name (COLON nls type (EQ nls expr)? | EQ nls expr) {pin=1}

operator_decl ::= EXPORT_KW? OPERATOR_KW ident generic_parameters? configuration_parameters? function_signature opt_requires operator_properties* {pin=2}
operator_properties ::= nls <<typeKw "PROPERTIES_KW">> LT nls <<list_of type>> nls GT nls
                        LBRACE nls <<list_of operator_property>> nls RBRACE {pin=2}
operator_property ::= ident (EQ grouped_expr)?

instantiate_decl ::= INSTANTIATE_KW <<list_of instantiation>> {pin=1}
instantiation ::= ident generic_arguments {pin=2}

function_decl ::= warning_annotation* (EXPORT_KW | IMPL_KW)? (<<kw "CONST_KW">>)? FN_KW ident generic_parameters? configuration_parameters? function_signature opt_requires function_body {pin=4}
private function_body ::= fat_arrow_body | body_gap block
// Pinned after `=>` so a missing body reads "expression expected".
private fat_arrow_body ::= fat_arrow_op expr {pin=1}

native_function_decl ::= native_function_head ident generic_parameters? configuration_parameters? function_signature opt_requires native_contract_body? {pin=1}
private native_function_head ::= (EXPORT_KW <<kw "NATIVE_KW">> | <<kw "NATIVE_KW">> IMPL_KW?) (<<kw "CONST_KW">>)? FN_KW
native_contract_body ::= body_gap LBRACE native_body_item* RBRACE {pin=2}
private native_body_item ::= !RBRACE (NEWLINE | native_member_item)
private native_member_item ::= !(NEWLINE | RBRACE) native_member_body {pin=1 recoverWhile=statement_recover}
private native_member_body ::= inject_decl SEMICOLON? | native_hook
native_hook ::= (START_KW | WHEN_KW | STOP_KW) SEMICOLON {pin=1}

test_context ::= TEST_KW body_gap LBRACE test_context_item* RBRACE {pin=2}
private test_context_item ::= !RBRACE (NEWLINE | test_member_item)
private test_member_item ::= !(NEWLINE | RBRACE) test_member_body {pin=1 recoverWhile=statement_recover}
private test_member_body ::= (function_decl | struct_decl | enum_decl | test_decl) &(NEWLINE | RBRACE) {pin=1}
test_decl ::= TEST_KW ident body_gap test_block | integration_test_head ident body_gap <<integrationBlock test_block>> {pin=2}
test_block ::= LBRACE nls (test_declaration &(NEWLINE | RBRACE) nls)* block_item* RBRACE {pin=1 elementType=block}
private test_declaration ::= !EXPORT_KW (function_decl | constant_decl | struct_decl | enum_decl | operator_decl)
private integration_test_head ::= timeout_annotation? <<kw "INTEGRATION_TEST_KW">>
timeout_annotation ::= AT <<kw "TIMEOUT_KW">> <<adjacent>> LPAREN nls TEMPORAL_LITERAL nls RPAREN NEWLINE+ {pin=2}

// ---------------------------------------------------------------------------
// Generics, signatures and constraints
// ---------------------------------------------------------------------------

generic_parameters ::= <<adjacent>> LT nls <<list_of generic_parameter>> nls GT {pin=2}
generic_parameter ::= <<kw "CONST_KW">> ident COLON nls type (EQ nls <<inGroup size_expression>>)? | ELLIPSIS ident pack_cardinality? | ident

configuration_parameters ::= LBRACE nls <<list_of configuration_parameter>> nls RBRACE {pin=1}
configuration_parameter ::= (<<kw "CONST_KW">>)? ident COLON nls type (EQ nls grouped_expr)? {pin=3}

function_signature ::= <<adjacent>> LPAREN nls <<list_of parameter>>? nls RPAREN (arrow_op REF_KW? type)? {pin=2}
parameter ::= VAR_KW ident COLON nls type
            | REF_KW ident COLON nls type (EQ nls grouped_expr)?
            | <<kw "CONST_KW">> ident COLON nls value_parameter
            | ident COLON nls (function_type | value_parameter)
private value_parameter ::= (pack | type) (EQ nls grouped_expr)?
function_type ::= (<<kw "CONST_KW">>)? FN_KW <<adjacent>> LPAREN nls <<list_of function_type_parameter>>? nls RPAREN (arrow_op REF_KW? type)? {pin=2}
function_type_parameter ::= pack | (ident COLON nls)? type
pack ::= ELLIPSIS pack_type pack_cardinality? {pin=1}
private pack_type ::= LBRACE nls type (FOR_KW simple_name (<<kw "WITHOUT_KW">> simple_name (comma_sep simple_name)*)?)? nls RBRACE | type
pack_cardinality ::= <<adjacent>> LBRACE nls INT_LITERAL nls (COLON nls (INT_LITERAL | STAR) nls)? RBRACE {pin=2}

private arrow_op ::= nls ARROW nls
private fat_arrow_op ::= nls FAT_ARROW nls

private opt_requires ::= (nls requires_clause)?
requires_clause ::= REQUIRES_KW nls constraint {pin=1}

constraint ::= constraint_and (or_op constraint_and)*
constraint_and ::= constraint_term (and_op constraint_term)*
constraint_term ::= constraint_atom (constraint_requirement | constraint_relation)?
private constraint_atom ::= constraint_each
                          | BANG constraint_term
                          | LPAREN nls constraint nls RPAREN
                          | constraint_operand
constraint_requirement ::= ARROW nls type {pin=1}
constraint_relation ::= (EQEQ | NEQ | IS_KW) constraint_operand
                      | <<kw "IN_KW">> (STRUCT_KW | ENUM_KW | constraint_operand)
constraint_each ::= (<<kw "EACH_KW">> | ANY_KW) for_binding <<kw "IN_KW">> constraint_operand LBRACE nls constraint nls RBRACE {pin=1}
constraint_set ::= LBRACE nls <<list_of constraint_operand>> nls RBRACE {pin=1}
constraint_call ::= &(ident (COLONCOLON ident)? LPAREN) qualified_name <<adjacent>> LPAREN nls <<list_of constraint_operand>>? nls RPAREN {pin=2}
constraint_operand ::= implied_member_expr | constraint_set
                     | (pack_member | container_type | scalar_type) QUESTION?
                     | constraint_call
                     | &(ident (LT | COLONCOLON | QUESTION)) named_type QUESTION?
                     | &constraint_value_start size_expression
                     | constraint_name
constraint_name ::= qualified_name
private constraint_value_start ::= INT_LITERAL | FLOAT_LITERAL | STRING_LITERAL | TEMPORAL_LITERAL
                                 | TRUE_KW | FALSE_KW | NULL_KW | MINUS

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

type ::= (scalar_type | container_type | pack_member | named_type) QUESTION?
scalar_type ::= scalar_type_keyword
private container_type ::= tuple_type | list_type | set_type | dict_type | rolling_type
                         | atomic_type | endpoint_type | signal_type | result_type | error_type | delta_type
tuple_type ::= TUPLE_KW LT nls <<list_of type>>? nls GT {pin=1}
list_type ::= LIST_KW LT nls type (comma_sep list_size nls)? GT {pin=1}
list_size ::= <<kw "UNBOUNDED_KW">> | size_expression
set_type ::= SET_KW LT nls type nls GT {pin=1}
dict_type ::= DICT_KW LT nls type comma_sep type nls GT {pin=1}
rolling_type ::= ROLLING_WINDOW_KW LT nls type comma_sep size_expression (comma_sep size_expression)? nls GT {pin=1}
atomic_type ::= ATOMIC_KW LT nls type nls GT {pin=1}
endpoint_type ::= ENDPOINT_KW LT nls type nls GT {pin=1}
pack_member ::= simple_name <<adjacent>> LBRACKET simple_name RBRACKET {pin=3}
signal_type ::= SIGNAL_KW
result_type ::= RESULT_KW LT nls type comma_sep type nls GT {pin=1}
error_type ::= ERROR_KW
delta_type ::= DELTA_KW LT nls type nls GT {pin=1}
named_type ::= qualified_name generic_arguments?

generic_arguments ::= <<adjacent>> LT nls <<list_of generic_argument>> nls GT {pin=2}
generic_argument ::= &(IDENTIFIER (LT | LBRACKET | COLONCOLON | QUESTION)) type | container_type QUESTION? | scalar_type QUESTION? | <<inGroup size_expression>>

// A size expression is parsed at additive precedence and above, so a `>`
// closes the enclosing list instead of starting a comparison.
private size_expression ::= <<sizeExpr>>

// ---------------------------------------------------------------------------
// Blocks and statements
// ---------------------------------------------------------------------------

private block_items ::= block_item*
block ::= LBRACE <<inBlock block_items>> RBRACE {pin=1}
private block_item ::= !RBRACE (NEWLINE | statement_item)
private statement_item ::= !(NEWLINE | RBRACE) statement_body {pin=1 recoverWhile=statement_recover}
private statement_body ::= statement &(NEWLINE | RBRACE | <<afterCommentBreak>>) {pin=1}
private statement_recover ::= !(NEWLINE | RBRACE | LET_KW | VAR_KW | STATE_KW | CACHE_KW | INJECT_KW
                               | START_KW | STOP_KW | WHEN_KW | FOR_KW | WHILE_KW | YIELD_KW
                               | RETURN_KW | ASSERT_KW | SWITCH_KW)

private statement ::= local_decl
            | state_decl
            | cache_decl
            | inject_decl
            | lifecycle_stmt
            | when_stmt
            | for_stmt
            | while_stmt
            | yield_stmt
            | switch_stmt
            | return_stmt
            | assert_stmt
            | expression_stmt

local_decl ::= (LET_KW | VAR_KW) ident (COLON nls type)? initializer? {pin=1}
state_decl ::= STATE_KW ident (COLON nls type)? initializer {pin=1}
cache_decl ::= CACHE_KW ident (COLON nls type)? initializer {pin=1}
// Pinned after `=` so `let x =` reads "expression expected" at the line end.
private initializer ::= EQ nls expr {pin=1}
inject_decl ::= INJECT_KW nls inject_item (&(nls COMMA nls IDENTIFIER) nls COMMA nls inject_item)* (nls COMMA)? {pin=1}
inject_item ::= ident operator_configuration?
lifecycle_stmt ::= (START_KW | STOP_KW) body_gap block {pin=1}
when_stmt ::= WHEN_KW (!LBRACE <<header expr>>)? body_gap block {pin=1}
for_stmt ::= FOR_KW for_binding (COMMA for_binding)? <<kw "IN_KW">> <<header iterable>> body_gap block {pin=1}
for_binding ::= ident
iterable ::= (<<sizeExpr>> RANGE nls <<sizeExpr>>) | expr
// SOURCE-1: an omitted condition is an unbounded loop; yield schedules a value.
while_stmt ::= WHILE_KW (!LBRACE <<header expr>>)? body_gap block {pin=1}
yield_stmt ::= YIELD_KW expr COLON nls expr {pin=1}
return_stmt ::= RETURN_KW expr? {pin=1}
assert_stmt ::= ASSERT_KW continuation_gap (raises_assertion | expr) {pin=1}
raises_assertion ::= RAISES_KW <<adjacent>> LPAREN nls grouped_expr nls RPAREN body_gap block {pin=1}
expression_stmt ::= expr assignment_tail?
assignment_tail ::= assign_op nls expr {pin=1}
private assign_op ::= EQ | PLUS_EQ | MINUS_EQ | STAR_EQ | SLASH_EQ | FLOOR_SLASH_EQ | PERCENT_EQ

// ---------------------------------------------------------------------------
// Expressions (Grammar-Kit expression group; later alternatives bind tighter)
// ---------------------------------------------------------------------------

expr ::= or_expr
       | and_expr
       | equality_expr
       | comparison_expr
       | add_expr
       | mul_expr
       | unary_expr
       | postfix_group
       | primary_group

private postfix_group ::= call_expr | index_expr | field_expr
private primary_group ::= applied_constructor_expr
                        | delta_expr
                        | literal_expr
                        | tuple_or_group_expr
                        | sequence_expr
                        | fn_expr
                        | if_expr
                        | eval_expr
                        | run_expr
                        | implied_member_expr
                        | type_of_expr
                        | type_call_expr
                        | brace_literal_expr
                        | pack_loop_expr
                        | key_membership_expr
                        | block_expr
                        | reference_expr

or_expr ::= expr or_op expr
and_expr ::= expr and_op expr
equality_expr ::= expr equality_op expr
comparison_expr ::= expr comparison_op expr
add_expr ::= expr add_op expr
mul_expr ::= expr mul_op expr
unary_expr ::= <<unaryExpression>>

// A binary operator may end a line or begin the next one (continued_operator).
private or_op ::= nls OROR (<<operatorOptions>>)? nls {pin=2}
private and_op ::= nls ANDAND (<<operatorOptions>>)? nls {pin=2}
private equality_op ::= nls (EQEQ | NEQ) (<<operatorOptions>>)? nls {pin=2}
private comparison_op ::= nls (LT | LE | GT | GE | SPACESHIP) (<<operatorOptions>>)? nls {pin=2}
private add_op ::= nls (PLUS | MINUS) (<<operatorOptions>>)? nls {pin=2}
private mul_op ::= nls (STAR | SLASH | FLOOR_SLASH | PERCENT) (<<operatorOptions>>)? nls {pin=2}

// The index suffix is a private rule so
// Grammar-Kit sees one operand and classifies the rule as postfix; written
// inline it would be a binary operator and parse the index at index priority.
call_expr ::= expr call_suffix
private call_suffix ::= call_options? arguments
// CTRL-9: only a symbol operator may take a configuration brace at header depth zero.
private call_options ::= &LBRACE <<braceInsideExpression>> operator_configuration
index_expr ::= expr index_suffix
private index_suffix ::= <<adjacent>> LBRACKET nls <<inGroup expr>> nls RBRACKET {pin=2}
field_expr ::= expr field_suffix
private field_suffix ::= nls DOT member_name {pin=2}
implied_member_expr ::= DOT member_name {pin=1}
type_of_expr ::= &(IDENTIFIER LPAREN) <<kw "TYPE_KW">> <<adjacent>> LPAREN nls grouped_expr nls RPAREN {pin=4}
type_call_expr ::= (STR_KW | BYTES_KW | ANY_KW | ERROR_KW) arguments {pin=1}

literal_expr ::= INT_LITERAL | FLOAT_LITERAL | STRING_LITERAL | TEMPORAL_LITERAL
               | TRUE_KW | FALSE_KW | NULL_KW | PLACEHOLDER
// One production for a parenthesised group and a tuple literal, as in the
// compiler (`tuple_or_group`): `(a)` groups, `()`, `(a,)` and `(a, b)` are
// tuples. Grammar-Kit would pin a separate `'(' expr ')'` rule after the
// opening parenthesis and never try the tuple alternative.
tuple_or_group_expr ::= LPAREN nls <<list_of grouped_expr>>? nls RPAREN
// EXPR-9: parse the first entry before choosing the tail. A generic argument's
// comma or a block statement's colon does not itself make the brace a literal.
brace_literal_expr ::= &LBRACE <<braceInsideExpression>> <<hasBraceSeparator>> LBRACE nls <<inGroup brace_entries>> nls RBRACE {pin=6}
private brace_entries ::= COMMA | COLON | brace_key_or_value (set_tail | keyed_tail)
private set_tail ::= comma_sep (<<list_of expr>>)?
private keyed_tail ::= nls COLON nls expr (comma_sep keyed_entry)* trailing_comma? {pin=2}
private keyed_entry ::= brace_key_or_value nls COLON nls expr
private brace_key_or_value ::= &(member_name nls COLON) member_name | expr
sequence_expr ::= LBRACKET nls <<inGroup sequence_content>>? nls RBRACKET {pin=1}
private sequence_content ::= loop_entries | sequence_entries
private sequence_entries ::= expr (COLON nls expr (comma_sep sequence_pair)* | (comma_sep expr)*) trailing_comma?
sequence_pair ::= expr COLON nls expr {pin=2}
loop_entries ::= FOR_KW for_binding <<kw "IN_KW">> iterable COLON nls expr {pin=5}
pack_loop_expr ::= &LBRACE <<braceInsideExpression>> LBRACE nls <<inGroup loop_entries>> nls RBRACE
fn_expr ::= FN_KW <<adjacent>> LPAREN nls <<list_of anonymous_parameter>>? nls RPAREN (arrow_op type)? (fat_arrow_op expr | body_gap block) {pin=1}
anonymous_parameter ::= ident (COLON nls type)?
if_expr ::= IF_KW <<header expr>> body_gap block (nls else_arm)? {pin=1}
else_arm ::= ELSE_KW (if_expr | body_gap block) {pin=1}
eval_expr ::= EVAL_KW harness_target {pin=1}
run_expr ::= <<inIntegrationBody>> RUN_KW harness_target {pin=2}
harness_target ::= call_options? qualified_name generic_arguments? call_suffix
key_membership_expr ::= simple_name <<kw "IN_KW">> &<<textIs "arg_keys">> qualified_name <<adjacent>> LPAREN nls simple_name nls RPAREN
block_expr ::= &LBRACE <<braceInsideExpression>> block
reference_expr ::= &IDENTIFIER qualified_name

// `name<...>(...)` is an applied struct constructor only when the token
// look-ahead says so (looks_like_applied_constructor in the compiler).
applied_constructor_expr ::= <<appliedConstructorAhead>> qualified_name generic_arguments call_suffix {pin=1}
delta_expr ::= DELTA_KW LT nls type nls GT arguments {pin=1}

arguments ::= <<adjacent>> LPAREN nls <<list_of argument>>? nls RPAREN {pin=2}
argument ::= &(member_name COLON) named_argument | ELLIPSIS grouped_expr | argument_value
private argument_value ::= function_reference | grouped_expr
function_reference ::= <<functionReferenceAhead>> qualified_name generic_arguments
named_argument ::= member_name COLON nls argument_value {pin=1}

// TYPE-7, CTRL-6, NATIVE-1, EXPR-10 and ERR-8.
enum_decl ::= EXPORT_KW? ENUM_KW ident body_gap LBRACE nls <<list_of enum_member>>? nls RBRACE {pin=2}
enum_member ::= member_name (EQ nls size_expression)?
native_type_decl ::= EXPORT_KW? <<kw "NATIVE_KW">> <<kw "TYPE_KW">> ident native_type_body? {pin=3}
native_type_body ::= body_gap LBRACE nls (native_property (NEWLINE+ native_property)* nls)? RBRACE {pin=2}
native_property ::= member_name COLON nls type {pin=2}
// After a symbol, {name,} is a set operand. A named configuration starts with a colon entry.
private symbol_options ::= &(LBRACE nls member_name COLON) operator_configuration
// Recognize an unfinished label in a configured call so its declaration can supply completion.
operator_configuration ::= &(LBRACE nls member_name (COLON | COMMA | RBRACE LPAREN)) LBRACE nls <<list_of named_argument>> nls RBRACE {pin=2}
warning_annotation ::= AT <<kw "SUPPRESS_WARNING_KW">> <<adjacent>> LPAREN nls STRING_LITERAL nls RPAREN NEWLINE+ {pin=2}
switch_stmt ::= SWITCH_KW continuation_gap <<header expr>> body_gap LBRACE nls switch_case* switch_default? RBRACE {pin=1}
switch_case ::= <<kw "CASE_KW">> expr COLON nls switch_body {pin=1}
switch_default ::= <<kw "DEFAULT_KW">> COLON nls switch_body {pin=1}
private switch_body ::= (!(RBRACE | <<isKw "CASE_KW">> | <<isKw "DEFAULT_KW">>) block_item)*
