module examples.expressions

export struct Box<T> {
    value: T
}

fn precedence(a: f64, b: f64, c: f64, flag: bool) -> bool {
    let sum = a + b * c - -a / (b % c) // 2.0
    let cmp = sum < a || a <= b && b > c || c >= a
    let eq = a == b != flag
    let neg = !flag && !(a != b)
    let idx = values[i + 1][0]
    let chained = book.levels[0].price
    let called = f(a)(b).g(c)[0]
    let boxed = Box<f64>(value: a).value
    let constructed = Node(value: 1, next: Node(value: 2))
    let lambda = map(values, fn(v: f64) -> f64 => v * 2.0)
    let chosen = if flag { a } else if a > b { b } else { c }
    let grouped = (if flag { 1 } else { 2 }) + 1
    let block = { let t = a + b
        t * 2.0 }
    let sel = const(flag)
    let d = delta<Box<f64>>(value: a)
    let unit = ()
    let single = (a,)
    let pair = (a, b)
    let nested = ((a, b), (c, a))
    let seq = [1, 2, 3,]
    let empty = []
    let tz = @[Europe/London]
    return cmp
}
