module core_conformance part join

/**
A list join preserves its list order and inserts the separator only
between entries, including empty entries.

Rules:
    OPS-11, FN-18

Status:
    agreed
*/
test join_lists {
    assert join{separator: "/"}([]) == ""
    assert join{separator: "/"}(["日"]) == "日"
    assert join{separator: "・"}(["a", "", "b"]) == "a・・b"
    assert join(["a", "b"]) == "a b"
}

/**
A positional-pack join puts each string in argument order with the
supplied or default separator between entries.

Rules:
    OPS-11, FN-8, FN-18

Status:
    agreed
*/
test join_positional_strings {
    assert join() == ""
    assert join{separator: "/"}("a") == "a"
    assert join("a", "b", "c") == "a b c"
    assert join{separator: ", "}("a", "b") == "a, b"
    assert join{separator: ""}("日", "b") == "日b"
}
