module conformance.rejections part run_configuration

# A node that publishes each reading.
fn relayed_reading(reading: i64) -> i64 {
    when { return reading }
}

/**
A run's configuration is supplied to the run, and no call constructs one:
`RunConfig` is the type of the capability `run_config`. A call of it is a
call of a native type's name, which rejects with the code
`call.not_callable`.

:Rules: RUN-6, NATIVE-6, CAP-1, CAP-7
:Status: agreed
*/
test a_run_configuration_constructed {
    # expect-error(type, "call.not_callable")
    let bounds = RunConfig(length: 3s)
}

/**
Each entry of an eval's configuration names a field of `RunConfig`:
`start`, `end` or `length`. One that names none is an argument that names
no parameter, and rejects with the code `argument.unknown`.

:Rules: RUN-6, TST-5, CAP-7
:Status: agreed
*/
test an_eval_configured_with_a_field_it_has_not {
    # expect-error(name, "argument.unknown")
    assert eval{until: 3us} relayed_reading(reading: [1]) == [1]
}

/**
A function does not inject `run_config`: one that needs a bound of its run
takes it as a `const` argument. The `inject` rejects with the code
`inject.position`.

:Rules: RUN-6, TIME-8, FN-9
:Status: agreed
*/
fn reading_bounded_by_its_run(reading: i64) -> i64 {
    # expect-error(injectable, "inject.position")
    inject run_config
    when { return reading }
}

/**
A test that is no integration test does not inject `run_config`: its
evals give their configuration in braces. The `inject` rejects with the
code `inject.position`.

:Rules: RUN-6, TST-3, TST-17
:Status: agreed
*/
test a_unit_test_injects_its_run_configuration {
    # expect-error(injectable, "inject.position")
    inject run_config
}

/**
Only `run_config` is injected with a configuration in braces. Braces on an
`inject` of any other capability reject with the code
`inject.configuration`.

:Rules: RUN-6, TIME-8
:Status: agreed
*/
fn stepped_time(reading: i64) -> datetime {
    # expect-error(injectable, "inject.configuration")
    inject clock{step: 1us}
    when { return clock.evaluation_time }
}

/**
A key of the global store keeps one type in a program. A `put` of a `str`
under a key a `put` of an `i64` used before rejects with the code
`store.key_type`, at the later use.

:Rules: TIME-8, CAP-6
:Status: agreed
*/
fn reading_stored_twice(reading: i64) -> i64 {
    inject global_state
    when {
        put(global_state, "conformance.rejections.reading", reading)
        # expect-error(injectable, "store.key_type")
        put(global_state, "conformance.rejections.reading", "text")
        return reading
    }
}

/**
A `get` of the store is a use of its key too. A `get` of an `f64` under a
key a `put` of an `i64` used before rejects with the code `store.key_type`.

:Rules: TIME-8, CAP-6
:Status: agreed
*/
fn reading_read_as_another_type(reading: i64) -> f64 {
    inject global_state
    when {
        put(global_state, "conformance.rejections.scaled", reading)
        # expect-error(injectable, "store.key_type")
        return get<f64>(global_state, "conformance.rejections.scaled")
    }
}
