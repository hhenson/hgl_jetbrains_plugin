module conformance part input_bindings

fn active_minus_selected(value: i64, enabled: bool) -> i64 =>
    value - switch_input_activity(enabled, value)

/**
Passivating one consumer's input leaves other consumers of the same output active.
The difference compares the live value to the last one forwarded by the
switchable consumer. It returns to zero when that consumer starts listening again.

:Rules: END-5, TIME-2, TIME-9
:Status: agreed
*/
test a_shared_output_keeps_its_other_subscribers {
    assert eval(active_minus_selected(
        value:   [10,   _,     20, 30, _,    40],
        enabled: [true, false, _,  _,  true, _])) ==
                 [0,    0,     10, 20, 0,    0]
}

fn data_on_manual_wake(data: i64, wake: i64) -> i64 {
    when modified(data) && valid(data) {
        activate(wake)
        passivate(data)
        return data
    }
}

/**
A manually activated input can wake a node whose only handler guards a different input.
The first data tick switches which input wakes the node. A wake alone leaves the
guard false. A data tick alone cannot wake the node. When both tick, the handler
sees the passive data input's current publication.

:Rules: TIME-2, TIME-3, TIME-9, END-2, END-5
:Status: agreed
*/
test a_manual_wake_still_checks_the_only_handlers_guard {
    assert eval(data_on_manual_wake(
        data: [1, _,  2,  3, 4],
        wake: [_, 10, 20, _, 40])) ==
              [1, _,  2,  _, 4]
}

fn joined_after_invalidation(command: i64, right: i64) -> i64 =>
    running_join(produce(command), right)

/**
Invalidating a required input blocks evaluation even when another input publishes.
The first pair adds 11 to the total. Zero invalidates the left input. The
right input keeps receiving values, so recovery adds 3 + 3 to the original 11.

:Rules: END-1, END-4, TIME-2, TIME-3
:Status: agreed
*/
test a_sibling_tick_cannot_admit_a_node_with_an_invalid_input {
    assert eval(joined_after_invalidation(
        command: [10, 0, _, 3,  _],
        right:   [1,  2, 3, _,  4])) ==
                 [11, _, _, 17, 24]
}

fn scaled_with_invalidation(value: i64, factor_command: i64) -> i64 =>
    scaled_value(value, produce(factor_command))

/**
Invalidating a lifted argument restores its default on that cycle.
Zero invalidates the factor, so 3 is scaled by the default of 2. A second
zero stays silent. The default still applies when value changes to 5.

:Rules: FN-6, FN-11, END-4
:Status: agreed
*/
test a_lifted_default_returns_after_invalidation {
    assert eval(scaled_with_invalidation(
        value:          [3,  _, _, _, 5,  _],
        factor_command: [4,  0, 0, _, _,  3])) ==
                        [12, 6, _, _, 10, 15]
}
