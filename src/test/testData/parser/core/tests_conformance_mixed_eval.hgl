module conformance part mixed_eval

# CEVAL-2 is agreed. The set delta profile is proposed.

fn relay_members(enabled: bool, members: set<i64>) -> set<i64> {
    when {
        if enabled && modified(members) {
            return delta_value(members)
        }
    }
}

/**
A node forwards a set delta only when the gate is open and the set publishes.
One addition arrives while the gate is closed. Opening the gate again produces
no tick of its own. The fixture uses the proposed set delta profile.

Rules:
    TIME-1, TIME-3, TYPE-16, CEVAL-3, TST-9

Status:
    proposed
*/
test mixed_replay {
    assert eval relay_members(
        enabled: [true, _, false, true, _],
        members: [
            _,
            delta<set<i64>>(added: [1, 2]),
            delta<set<i64>>(added: [5]),
            _,
            delta<set<i64>>(added: [3], removed: [1])
        ]) == [
        _,
        delta<set<i64>>(added: [1, 2]),
        _,
        _,
        delta<set<i64>>(added: [3], removed: [1])
    ]
}
