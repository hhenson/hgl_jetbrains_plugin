module core part mapping

# Fixed-size mapping and reduction (spec/mapping.md).

/**
Choose which keys or positions a map takes from its split inputs.

Examples:
    With fixed-size lists, every join takes the same positions.

    ~~~hgl
    fn line_total(price: i64, quantity: i64) -> i64 => price * quantity
    fn totals(prices: list<i64, 2>, quantities: list<i64, 2>) -> list<i64, 2> =>
        map{join: .outer}(line_total, prices, quantities)
    assert eval totals(prices: [[2, 3]], quantities: [[5, 7]]) == [[10, 21]]
    ~~~

    With different dictionary keys, the child can publish its own key
    even when an entry is missing. The native keyed candidate has yet
    to be implemented.

    ~~~hgl no-run
    fn label_key(key: str, first_value: i64, second_value: i64) -> str => key
    fn inner_labels(first: dict<str, i64>, second: dict<str, i64>) -> dict<str, str> =>
        map{join: .inner}(label_key, first, second)
    fn outer_labels(first: dict<str, i64>, second: dict<str, i64>) -> dict<str, str> =>
        map{join: .outer}(label_key, first, second)
    fn left_labels(first: dict<str, i64>, second: dict<str, i64>) -> dict<str, str> =>
        map{join: .left}(label_key, first, second)
    assert eval inner_labels(first: [["a": 1, "b": 2]], second: [["b": 3, "c": 4]]) ==
        [["b": "b"]]
    assert eval outer_labels(first: [["a": 1, "b": 2]], second: [["b": 3, "c": 4]]) ==
        [["a": "a", "b": "b", "c": "c"]]
    assert eval left_labels(first: [["a": 1, "b": 2]], second: [["b": 3, "c": 4]]) ==
        [["a": "a", "b": "b"]]
    ~~~

Rules:
    MAP-5, MAP-6
*/
export enum Join {
    /**
    Take the keys or positions present in every split input.

    Rules:
        MAP-5, MAP-6
    */
    inner,
    /**
    Take the keys or positions present in any split input.

    Rules:
        MAP-5, MAP-6
    */
    outer,
    /**
    Take the keys or positions of the first split input in parameter order.

    Rules:
        MAP-5, MAP-6
    */
    left,
}

/**
Apply a function to each key or position as its own child graph.

An argument of the corresponding parameter's type goes whole to every
child. A collection of that type is split so each child receives only
the entry at its key or position. At least one argument must be split.

| Split arguments | Result |
| --- | --- |
| Dictionaries sharing a key type | A dictionary with the same key type |
| Lists of one fixed size | A list of that size |
| Lists whose sizes can change | A list whose size can change |

Type Args:
    R: The child's result type.
    C: The mapped result's collection type.
    Ps: The types of the child's parameters, under their names or positions.
    As: The types of the arguments given to the child.
    key: The name of the parameter that receives the child's key or position.
        Its default is `"key"`. Leave that parameter out of the call.

Args:
    f: The child function, with its generic arguments where it needs them.
    args: The child's other arguments, given by name or position.

Options:
    - `join`: Which keys or positions to take, `.inner` by default. For lists of one fixed size the joins give the same positions.
    - `keys`: The keys to use for a dictionary map. When omitted the join chooses them.

Returns:
    One entry for each child that has published. A failure leaving a child
    leaves the map. A fixed-size map gives no result when its child gives none.

Ticks:
    An entry ticks when its child publishes and is removed when its child stops.

Validity:
    An entry is valid after its child publishes. With `.outer`, `.left` or
    explicit `keys`, a split input that lacks a child's key or position is
    invalid until its entry arrives.

Raises:
    - `operator.no_candidate`: No argument splits, or the split arguments have incompatible collection types.

Examples:
    ~~~hgl
    fn scaled(price: f64, factor: f64) -> f64 => price * factor
    fn scaled_pair(prices: list<f64, 2>, factor: f64) -> list<f64, 2> =>
        map(scaled, prices, factor)
    assert eval scaled_pair(prices: [[2.0, 3.0]], factor: [4.0]) == [[8.0, 12.0]]
    ~~~

    A keyed map with an explicit set selects only those keys.

    ~~~hgl
    fn double_price(price: i64) -> i64 => price * 2
    fn selected_prices(prices: dict<str, i64>, selected: set<str>) -> dict<str, i64> =>
        map{keys: selected}(double_price, prices)
    assert eval selected_prices(prices: [["west": 2, "east": 3]], selected: [["west"]]) ==
        [["west": 4]]
    ~~~

    A list can gain positions as it changes. The native positional
    candidate has yet to be implemented.

    ~~~hgl no-run
    fn double_item(item: i64) -> i64 => item * 2
    fn double_items(items: list<i64>) -> list<i64> => map(double_item, items)
    assert eval double_items(items: [[2, 3]]) == [[4, 6]]
    ~~~

Rules:
    MAP-1, MAP-2, MAP-3, MAP-4, MAP-5, MAP-6, MAP-7, MAP-8, MAP-9, MAP-10
*/
export operator map<R, C, ...Ps, ...As, const key: str = "key">{
    const join: Join = .inner,
}(f: fn(...{Ps}) -> R, args: ...{As for f without key}) -> C

# By position, over lists of one fixed size: written in HGL. One call of
# `f` for each position, each given a pack made from `f`'s own parameters.
impl fn map<R, N, ...Ps, ...As, const key: str = "key">{
    const join: Join = .inner,
}(f: fn(...{Ps}) -> R, args: ...{As for f without key}) -> list<R, N>
    requires any arg in arg_keys(As) { As[arg] == list<Ps[arg], N> }
          && each arg in arg_keys(As) { As[arg] in {Ps[arg], list<Ps[arg], N>} }
{
    return [for i in 0..<N:
        f(...{for arg in arg_keys(Ps):
            if arg == key { i }
            else if arg in arg_keys(As) { at_position<Ps[arg]>(args[arg], i) }})]
}

/**
Run one child with no result for each fixed position.

Rules:
    MAP-7, MAP-10, GEN-6
*/
impl fn map<const N: i64, ...Ps, ...As, const key: str = "key">{
    const join: Join = .inner,
}(f: fn(...{Ps}), args: ...{As for f without key})
    requires any arg in arg_keys(As) { As[arg] == list<Ps[arg], N> }
          && each arg in arg_keys(As) { As[arg] in {Ps[arg], list<Ps[arg], N>} }
{
    for i in 0..<N {
        f(...{for arg in arg_keys(Ps):
            if arg == key { i }
            else if arg in arg_keys(As) { at_position<Ps[arg]>(args[arg], i) }})
    }
}

# One argument at one position: its entry where it is split, itself where
# it is whole. The candidates are selected by type. Not exported.
operator at_position<P, A>(arg: A, const at: i64) -> P
impl fn at_position<P, N>(arg: list<P, N>, const at: i64) -> P => arg[at]
impl fn at_position<P>(arg: P, const at: i64) -> P => arg

/**
Combine a collection's valid members into one value.

The tree form takes a function of one type and may group members in any
order allowed by the collection and its laws. Over a fixed-size list it
folds in position order from the first valid entry. The ordered form folds a
list from `zero`, in position order, and can accumulate a different type.

| Items | Forms |
| --- | --- |
| List, including one of fixed size | Tree and ordered |
| Set or dictionary | Tree, when the function is commutative as well |

Type Args:
    L: The accumulator and result type.
    R: The member type.
    C: The collection type.
    associative: Whether the tree form is permitted.
    commutative: Whether the tree form may change the order of members.

Args:
    f: The function of an accumulator and a member that returns an accumulator.
    items: The collection to reduce. A dictionary supplies its values.
    zero: The ordered form's required starting value. A non-null value given to
        the tree form must be an identity of `f`.

Options:
    - `associative`: Select the tree form when true and the ordered form when false. Defaults to the law declared for `f`.
    - `commutative`: Required for sets and dictionaries. Defaults to the law declared for `f`.

Returns:
    The reduction. With no members to combine, it gives `zero` when supplied
    and otherwise has no valid value. The fixed-size tree form rejects a
    list of size zero.

Ticks:
    The result follows the publications of the inputs the reduction reads.

Validity:
    The ordered form waits for a valid `zero`. It carries the accumulator
    past an invalid member. The tree form combines two valid sides and
    forwards the one valid side of a pair. A withdrawn member leaves the
    reduction of the members that remain. A step combines while its
    accumulator and member are both valid. When a stopped step starts
    again, its callback has fresh state.

    Over a list of nonnullable members, a nullable combiner receives every
    position, with null for an invalid endpoint. Over a list of nullable
    members, a published null is a valid member and an invalid endpoint
    is skipped. The nullable tree starts on the list's first publication
    and takes no part of `zero`.

Raises:
    - `operator.no_candidate`: An ordered reduction omits its zero or a set or dictionary lacks the required tree laws.

Examples:
    ~~~hgl
    fn pair_sum(items: list<i64, 2>) -> i64 => reduce(add_, items)
    assert eval pair_sum(items: [[2, 3], [4, 5]]) == [5, 9]
    ~~~

    An ordered fold starts from its seed. Here the seed supplies the
    first digit, and the member positions supply the next two.

    ~~~hgl
    const fn append_digit(accumulated: i64, digit: i64) -> i64 => accumulated * 10 + digit
    fn pair_digits(digits: list<i64, 2>) -> i64 => reduce(append_digit, digits, 1)
    assert eval pair_digits(digits: [[2, 3], [4, 5]]) == [123, 145]
    ~~~

    An invalid position is skipped until it publishes.

    ~~~hgl
    fn live_sum(items: list<i64, 3>) -> i64 => reduce(add_, items, 0)
    assert eval live_sum(items: [
        delta<list<i64, 3>>(updated: [0: 2, 2: 7]),
        delta<list<i64, 3>>(updated: [1: 4]),
        delta<list<i64, 3>>(removed: [1]),
    ]) == [9, 13, 9]
    ~~~

    A nullable combiner here uses five for a position that has not published.

    ~~~hgl
    const fn append_published(accumulated: i64, digit: i64?) -> i64 {
        return accumulated * 10 + (if digit == null { 5 } else { digit })
    }
    fn nullable_digits(digits: list<i64, 2>) -> i64 => reduce(append_published, digits, 1)
    assert eval nullable_digits(digits: [
        delta<list<i64, 2>>(updated: [1: 7]),
        delta<list<i64, 2>>(updated: [0: 2]),
    ]) == [157, 127]
    ~~~

    The ordered form skips positions that are not valid, and an empty
    growing list gives the seed.

    ~~~hgl
    const fn append_digit(accumulated: i64, digit: i64) -> i64 => accumulated * 10 + digit
    fn list_digits(digits: list<i64>) -> i64 => reduce(append_digit, digits, 1)
    assert eval list_digits(digits: [
        [],
        delta<list<i64>>(updated: [0: 2, 2: 7], size_modified: 3),
        delta<list<i64>>(updated: [1: 4]),
        delta<list<i64>>(removed: [1])
    ]) == [1, 127, 1247, 127]
    ~~~

    The tree candidate over a growing list is a native obligation.

    ~~~hgl no-run
    fn list_sum(items: list<i64>) -> i64 => reduce(add_, items, 0)
    assert eval list_sum(items: [[2, 3]]) == [5]
    ~~~

    A set uses the tree form with a commutative function. Its native
    candidate has yet to be implemented.

    ~~~hgl no-run
    fn set_sum(items: set<i64>) -> i64 => reduce(add_, items, 0)
    assert eval set_sum(items: [[2, 3]]) == [5]
    ~~~

    A dictionary reduces its values. Its native candidate has yet to
    be implemented.

    ~~~hgl no-run
    fn dictionary_sum(items: dict<str, i64>) -> i64 => reduce(add_, items, 0)
    assert eval dictionary_sum(items: [["west": 2, "east": 3]]) == [5]
    ~~~

Rules:
    RED-1, RED-2, RED-3, RED-4, RED-5, RED-6, RED-7
*/
export operator reduce<L, R, C,
    const associative: bool = associative(f),
    const commutative: bool = commutative(f),
>(f: fn(L, R) -> L, items: C, zero: L? = null) -> L

fn reduction_is_valid<V>(value: V) -> bool {
    when valid([]) { return valid(value) }
}

fn reduction_pair_validity<V>(left: V, right: V) -> tuple<bool, bool> {
    when valid([]) { return (valid(left), valid(right)) }
}

fn reduce_tree_pair<V>(f: fn(V, V) -> V, left: V, right: V) -> V {
    let present = reduction_pair_validity(left, right)
    return if present[0] {
        if present[1] { f(left, right) } else { left }
    } else { right }
}

fn tree_reduction_has_member<V>(accumulated: V, zero: signal) -> bool {
    when valid([]) { return valid(accumulated) }
}

fn tree_reduction_zero<V>(zero: V?) -> V {
    inject out
    when valid([]) {
        if valid(zero) && zero != null { return zero }
        invalidate(out)
    }
}

# A fixed-size tree keeps the first valid member and combines the rest.
impl fn reduce<V, N, const associative: bool = associative(f)>(
    f: fn(V, V) -> V, items: list<V, N>, zero: V? = null) -> V
    requires associative && N != 0
{
    var accumulated = items[0]
    for i in 1..<N { accumulated = reduce_tree_pair(f, accumulated, items[i]) }
    return if tree_reduction_has_member(accumulated, zero) {
        accumulated
    } else { tree_reduction_zero(zero) }
}

fn ordered_reduction_ready<L, R>(accumulated: L, member: R) -> bool {
    when valid([]) { return valid(accumulated) && valid(member) }
}

fn reduce_ordered_member<L, R>(f: fn(L, R) -> L, accumulated: L, member: R) -> L {
    return if ordered_reduction_ready(accumulated, member) {
        f(accumulated, member)
    } else { accumulated }
}

# A fixed-size ordered fold starts at zero and skips invalid members.
impl fn reduce<L, R, N, const associative: bool = associative(f)>(
    f: fn(L, R) -> L, items: list<R, N>, zero: L) -> L
    requires !associative
{
    var accumulated = zero
    for member in items { accumulated = reduce_ordered_member(f, accumulated, member) }
    return accumulated
}

fn reduce_ordered_nullable_member<L, R>(f: fn(L, R?) -> L, accumulated: L, member: R) -> L {
    let value = nullable_reduction_member(member, accumulated)
    return if reduction_is_valid(accumulated) { f(accumulated, value) } else { accumulated }
}

# A nullable combiner over nonnullable members receives every position.
impl fn reduce<L, R, N, const associative: bool = associative(f)>(
    f: fn(L, R?) -> L, items: list<R, N>, zero: L) -> L
    requires !associative
{
    var accumulated = zero
    for member in items {
        accumulated = reduce_ordered_nullable_member(f, accumulated, member)
    }
    return accumulated
}

fn nullable_reduction_member<V>(member: V, wake: signal) -> V? {
    state was_valid: bool = false
    inject out
    when valid([]) {
        let present = valid(member)
        # The other input can wake a position for its first publication.
        # A later tick of that input alone leaves the member idle.
        if !valid(out) || present != was_valid || (present && modified(member)) {
            was_valid = present
            if valid(member) { return member }
            return null
        }
    }
}

fn reduce_tree_nullable_pair<V>(f: fn(V?, V?) -> V?, left: V?, right: V?) -> V? {
    # The next pair waits for the preceding pair to publish, including null.
    return if reduction_is_valid(left) { f(left, right) } else { left }
}

impl fn reduce<V, N, const associative: bool = associative(f)>(
    f: fn(V?, V?) -> V?, items: list<V, N>, zero: V? = null
) -> V?
    requires associative && N != 0
{
    # A list tick supplies a null even for a position that has never published.
    var accumulated = nullable_reduction_member(items[0], items)
    for i in 1..<N {
        accumulated = reduce_tree_nullable_pair(f, accumulated, nullable_reduction_member(items[i], items))
    }
    return accumulated
}
