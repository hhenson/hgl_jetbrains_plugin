module conformance part scalar_endpoints

# Probe ticks let the observers read an idle or invalid watched input.

fn watched_valid(watched: i64, probe: bool) -> bool {
    when valid([]) {
        return valid(watched)
    }
}

fn watched_modified(watched: i64, probe: bool) -> bool {
    when modified() && valid([]) {
        return modified(watched)
    }
}

# Only probe is subscribed. valid() requires both inputs to be valid.
fn sample_on_probe(watched: i64, probe: bool) -> i64 {
    when modified(probe) && valid() {
        return watched
    }
}

/**
A scalar becomes valid on its first publication and stays valid through silence.
A separate probe wakes the observer before and after that publication.

:Rules: END-1, TIME-3
:Status: agreed
*/
test silence_preserves_validity {
    assert eval watched_valid(
                watched: [_, 7, _, _],
                probe: [true, true, true, true]) == [false, true, true, true]
}

/**
An observer woken by either input sees modification only on publication cycles.
The final equal value wakes the observer while the probe is silent.

:Rules: END-2, TIME-3
:Status: agreed
*/
test equal_publication_is_modified_and_idle_is_not {
    assert eval watched_modified(
                watched: [_, 7, _, 7],
                probe: [true, true, true, _]) == [false, true, false, true]
}

/**
A probe reads the latest valid payload of a passive input.
An update on the watched input alone stays silent until the next probe.

:Rules: END-1, END-5, TIME-3
:Status: agreed
*/
test retained_value_is_read_without_a_new_tick {
    assert eval sample_on_probe(
                watched: [_, 7, _, _, 9, _],
                probe: [true, _, true, true, _, true]) == [_, _, 7, 7, _, 9]
}

fn produce(command: i64) -> i64 {
    inject out
    when {
        if command != 0 { return command }
        invalidate(out)
    }
}

fn watch(input: i64) -> bool {
    when valid([]) { return valid(input) }
}

fn observe(command: i64) -> bool => watch(produce(command))

/**
Invalidating a valid endpoint wakes its subscriber once.
Zero requests invalidation. A second zero leaves it invalid and silent.

:Rules: END-4, TIME-3
:Status: agreed
*/
test publish_invalidate_recover {
    assert eval observe(command: [7, 0, 0, 7]) == [true, false, _, true]
}

fn publish_nullable(command: i64) -> i64? {
    when {
        if command == 0 { return null }
        return command
    }
}

fn read_validity(probe: bool, watched: i64?) -> bool {
    when modified(probe) && valid([]) { return valid(watched) }
}

fn observe_validity(command: i64, probe: bool) -> bool =>
    read_validity(probe, publish_nullable(command))

/**
Publishing null makes a nullable endpoint valid.
The probe samples before publication, on the null, through silence and at the next value, 7.

:Rules: END-1, TIME-7
:Status: agreed
*/
test publication_establishes_validity {
    assert eval observe_validity(
                command: [_, 0, _, 7],
                probe: [true, true, true, true]) == [false, true, true, true]
}

fn publish_value(value: i64) -> i64 {
    when { return value }
}

fn read_modified(watched: i64, probe: bool) -> bool {
    when modified(probe) && valid([]) { return modified(watched) }
}

fn observe_modified(value: i64, probe: bool) -> bool =>
    read_modified(publish_value(value), probe)

/**
A probe sees a forwarded equal value as modified on its publication cycle.
Between the two publications the producer is silent and the probe observes false.

:Rules: END-2, TIME-3
:Status: agreed
*/
test equal_publications_are_modified {
    assert eval observe_modified(
                value: [_, 7, _, 7],
                probe: [true, true, true, true]) == [false, true, false, true]
}

# Every input wakes the node, and nothing is required valid.
fn forward_when_modified(value: i64, probe: bool) -> i64 {
    when valid([]) {
        if modified(value) { return value }
        return -1
    }
}

/**
A test of `modified` guards the read of the input it names, as one of `valid` does.
An input is not modified without being valid, so the read of `value`
under `modified(value)` is admitted. The probe wakes the node in the
cycles where `value` is silent, before it is valid and after.

:Rules: TIME-4, TIME-3, END-2
:Status: agreed
*/
test a_modified_test_guards_the_read_of_its_input {
    assert eval forward_when_modified(
        value: [   _,    7,    _],
        probe: [true, true, true],
    )  ==      [  -1,    7,   -1]
}
