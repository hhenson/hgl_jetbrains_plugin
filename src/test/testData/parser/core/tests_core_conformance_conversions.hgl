module core_conformance part conversions

const fn whole(value: f64, rounding: Rounding) -> i64 =>
    convert<i64>(value, rounding: rounding, invalid: .fail)

# What `text` is as an `f64`, written again: a text that reads back.
const fn again(text: str) -> str => convert<str>(convert<f64>(text, invalid: .fail))

# OPS-6: a number to and from a `bool`, and an `i64` to an `f64`.
test a_number_is_a_flag_and_back {
    assert convert<f64>(3) == 3.0
    assert convert<bool>(7) && !convert<bool>(0)
    assert convert<bool>(0.5) && !convert<bool>(0.0)
    let nan: f64 = 0.0 /{zero: .nan} 0.0
    assert convert<bool>(nan)
    assert convert<i64>(true) == 1 && convert<i64>(false) == 0
    assert convert<f64>(true) == 1.0 && convert<f64>(false) == 0.0
}

# OPS-7, OPS-8: an `f64` to an `i64` under each rounding.
test an_f64_is_rounded_as_asked {
    assert whole(2.9, .truncate) == 2 && whole(-2.9, .truncate) == -2
    assert whole(-2.5, .floor) == -3 && whole(-2.5, .ceiling) == -2
    assert whole(2.5, .half_even) == 2 && whole(3.5, .half_even) == 4
    assert whole(2.5, .half_up) == 3 && whole(-2.5, .half_up) == -3
    assert whole(2.5, .half_down) == 2 && whole(-2.5, .half_down) == -2
    assert whole(2.6, .half_down) == 3 && whole(2.4, .half_up) == 2
    # `.truncate` where none is given, and a `result` where `invalid` is not.
    assert convert<i64>(2.9, invalid: .fail) == 2
    assert is_ok(convert<i64>(2.9))
}

# OPS-7: a NaN, an infinity and a number outside `i64` once rounded fail,
# and OPS-8: `nan` is what a NaN converts to.
test an_f64_that_is_no_i64_fails {
    let nan: f64 = 0.0 /{zero: .nan} 0.0
    assert is_err(convert<i64>(nan))
    assert is_err(convert<i64>(1.0 / 0.0)) && is_err(convert<i64>(-1.0 / 0.0))
    assert is_err(convert<i64>(9223372036854775808.0))
    assert is_ok(convert<i64>(-9223372036854775808.0))
    assert convert<i64>(nan, nan: -1, invalid: .fail) == -1
    assert raises("convert.invalid") { convert<i64>(nan, invalid: .fail) }
    assert raises("convert.invalid") { convert<i64>(1e19, invalid: .fail) }
}

# OPS-6: the text of an `i64` and of a `bool`.
test an_integer_and_a_flag_are_written {
    assert convert<str>(42) == "42"
    assert convert<str>(-3) == "-3"
    assert convert<str>(0) == "0"
    assert convert<str>(-9223372036854775807 - 1) == "-9223372036854775808"
    assert convert<str>(true) == "true" && convert<str>(false) == "false"
}

# OPS-6: the text of an `f64` is the shortest that reads back, with a `.`
# or an exponent.
test an_f64_is_written_as_the_shortest_text_that_reads_back {
    assert convert<str>(3.0) == "3.0"
    assert convert<str>(0.1) == "0.1"
    assert convert<str>(-2.5) == "-2.5"
    assert convert<str>(0.1 + 0.2) == "0.30000000000000004"
    assert convert<str>(-0.0) == "-0.0"
    # An exponent from 1e16 up, and below 1e-4.
    assert convert<str>(1000000000000000.0) == "1000000000000000.0"
    assert convert<str>(10000000000000000.0) == "1e16"
    assert convert<str>(1e21) == "1e21"
    assert convert<str>(1.5e300) == "1.5e300"
    assert convert<str>(0.0001) == "0.0001"
    assert convert<str>(0.00001) == "1e-5"
    assert convert<str>(1.5e-7) == "1.5e-7"
    let nan: f64 = 0.0 /{zero: .nan} 0.0
    assert convert<str>(nan) == "nan"
    assert convert<str>(1.0 / 0.0) == "inf" && convert<str>(-1.0 / 0.0) == "-inf"
}

# OPS-6: text is an `i64` where it is an integer literal, after one `-`.
test text_is_read_as_an_integer {
    assert convert<i64>("42", invalid: .fail) == 42
    assert convert<i64>("-3", invalid: .fail) == -3
    assert convert<i64>("0x1F", invalid: .fail) == 31
    assert convert<i64>("-0b101", invalid: .fail) == -5
    assert convert<i64>("1_000", invalid: .fail) == 1000
    assert convert<i64>("-9223372036854775808", invalid: .fail) == -9223372036854775807 - 1
    # OPS-7: text that is no such literal, and a number outside `i64`.
    assert is_err(convert<i64>("9223372036854775808"))
    assert is_err(convert<i64>("three")) && is_err(convert<i64>(""))
    assert is_err(convert<i64>(" 3")) && is_err(convert<i64>("3 "))
    assert is_err(convert<i64>("+3")) && is_err(convert<i64>("--3"))
    assert is_err(convert<i64>("3.0")) && is_err(convert<i64>("1__0"))
    assert raises("convert.invalid") { convert<i64>("three", invalid: .fail) }
}

# OPS-6: text is an `f64` where it is a float or an integer literal, after
# one `-`, or names a NaN or an infinity.
test text_is_read_as_a_float {
    assert convert<f64>("2.5", invalid: .fail) == 2.5
    assert convert<f64>("-1e5", invalid: .fail) == -100000.0
    assert convert<f64>("3", invalid: .fail) == 3.0
    assert convert<f64>("1_0.5E1", invalid: .fail) == 105.0
    assert convert<f64>("inf", invalid: .fail) == 1.0 / 0.0
    assert convert<f64>("-inf", invalid: .fail) == -1.0 / 0.0
    let nan = convert<f64>("nan", invalid: .fail)
    assert nan != nan
    # The text a number converts to converts back to that number.
    assert again("0.30000000000000004") == "0.30000000000000004"
    assert again("1e21") == "1e21" && again("-0.0") == "-0.0"
    assert again("nan") == "nan" && again("-inf") == "-inf"
    # OPS-7: text that is neither, and a number that rounds to an infinity.
    assert is_err(convert<f64>("1e999")) && is_err(convert<f64>(".5"))
    assert is_err(convert<f64>("NaN")) && is_err(convert<f64>("+inf"))
    assert is_err(convert<f64>("2.5 ")) && is_err(convert<f64>("1e"))
    assert raises("convert.invalid") { convert<f64>("two", invalid: .fail) }
}

# OPS-6, OPS-7: text and a `bool`, text and bytes, a `date` and a `datetime`.
test the_other_conversions {
    assert convert<bool>("true", invalid: .fail) && !convert<bool>("false", invalid: .fail)
    assert is_err(convert<bool>("True")) && is_err(convert<bool>(""))
    assert raises("convert.invalid") { convert<bool>("yes", invalid: .fail) }
    assert convert<str>(convert<bytes>("h\u{e9}llo"), invalid: .fail) == "h\u{e9}llo"
    assert convert<datetime>(@2026-03-01) == @2026-03-01T00:00:00Z
    assert convert<date>(@2026-03-01T23:59:59Z) == @2026-03-01
}

enum ConversionSide {
    left = -4,
    next,
    right = 7,
    lowest = -9223372036854775808,
    largest = 9223372036854775807,
}
enum NoConversionMembers {}

const fn named_member<E>(value: E) -> str requires E in enum => convert<str>(value)
const fn numbered_member<E>(number: i64) -> result<E, error>
    requires E in enum => convert<E>(number)

fn read_side(number: i64) -> result<ConversionSide, error> => convert<ConversionSide>(number)
fn show_side(side: ConversionSide) -> str => convert<str>(side)
fn number_side(side: ConversionSide) -> i64 => convert<i64>(side)
fn require_side(number: i64) -> ConversionSide => convert<ConversionSide>(number, invalid: .fail)

const fn side_outcome(value: result<ConversionSide, error>) -> str {
    if is_err(value) { return value.error.code }
    return convert<str>(value.value)
}

fn traced_side(number: i64) -> str => side_outcome(read_side(number))

fn read_empty_enum(number: i64) -> result<NoConversionMembers, error> =>
    convert<NoConversionMembers>(number)

const fn empty_conversion_failed(value: result<NoConversionMembers, error>) -> bool =>
    is_err(value)

fn observe_empty_conversion(number: i64) -> bool =>
    empty_conversion_failed(read_empty_enum(number))

fn require_empty_enum(number: i64) -> NoConversionMembers =>
    convert<NoConversionMembers>(number, invalid: .fail)

fn show_required_empty(number: i64) -> str =>
    convert<str>(require_empty_enum(number))

fn nullable_empty_enum(number: i64) -> NoConversionMembers? =>
    convert<NoConversionMembers>(number)

fn is_null_empty(value: NoConversionMembers?) -> bool {
    when modified(value) { return value == null }
}

fn observe_nullable_empty(number: i64) -> bool =>
    is_null_empty(nullable_empty_enum(number))

const conversion_side_key: str = "side"
const fn accepts_conversion_side(side: ConversionSide) -> i64 => convert<i64>(side)

const fn checked_reflected_enum<...Ps>(callback: const fn(...{Ps}) -> i64, number: i64)
    -> result<Ps[conversion_side_key], error>
    requires Ps[conversion_side_key] in enum => convert<Ps[conversion_side_key]>(number)

const fn forced_reflected_enum<...Ps>(callback: const fn(...{Ps}) -> i64, number: i64)
    -> Ps[conversion_side_key]
    requires Ps[conversion_side_key] in enum =>
        convert<Ps[conversion_side_key]>(number, invalid: .fail)

/**
An enum converts to its member's name and to its signed number.
Implicit numbering follows the previous member's number.

Rules:
    TYPE-7, GEN-3, OPS-4, OPS-6

Status:
    agreed
*/
test enum_name_and_number {
    assert convert<str>(ConversionSide.next) == "next"
    assert convert<i64>(ConversionSide.left) == -4
    assert convert<i64>(ConversionSide.next) == -3
    assert convert<i64>(ConversionSide.lowest) == -9223372036854775808
    assert convert<i64>(ConversionSide.largest) == 9223372036854775807
    assert named_member(ConversionSide.next) == "next"
    assert named_member(CmpResult.greater) == "greater"
    assert ConversionSide("right") == .right
    assert ConversionSide(-3) == .next
}

/**
Core enums have the same named and numbered members in both directions of
conversion. Checks of `.fail` and the checked return use the proposed
OPS-7 failure profile.

Rules:
    TYPE-7, OPS-4, OPS-6, OPS-7, OPS-8

Status:
    proposed
*/
test runtime_owned_enum_conversions {
    assert convert<str>(Stream.out) == "out" && convert<str>(Stream.err) == "err"
    assert convert<i64>(Stream.out) == 0 && convert<i64>(Stream.err) == 1
    assert convert<Stream>(0) == Stream.out
    assert convert<Stream>(1) == Stream.err
    assert convert<Stream>(0, invalid: .fail) == Stream.out
    assert convert<Stream>(1, invalid: .fail) == Stream.err

    assert convert<str>(CmpResult.unordered) == "unordered"
    assert convert<i64>(CmpResult.unordered) == 3
    assert convert<CmpResult>(3, invalid: .fail) == .unordered
    assert convert<str>(ZeroPolicy.fail) == "fail"
    assert convert<i64>(ZeroPolicy.fail) == 3
    assert convert<ZeroPolicy>(3, invalid: .fail) == .fail
    assert convert<str>(Rounding.half_down) == "half_down"
    assert convert<i64>(Rounding.half_down) == 5
    assert convert<Rounding>(5, invalid: .fail) == .half_down
    assert convert<str>(InvalidPolicy.fail) == "fail"
    assert convert<i64>(InvalidPolicy.fail) == 1
    assert convert<InvalidPolicy>(1, invalid: .fail) == .fail
    assert convert<str>(LogLevel.error) == "error"
    assert convert<i64>(LogLevel.error) == 3
    assert convert<LogLevel>(3, invalid: .fail) == .error
}

/**
An integer that has no enum member is an Err by default and escapes under
`.fail` under the proposed OPS-7 failure profile.

Rules:
    TYPE-7, OPS-4, OPS-6, OPS-7, OPS-8

Status:
    proposed
*/
test enum_numbers_use_the_conversion_policy {
    let checked = convert<ConversionSide>(-4, invalid: .error)
    assert is_ok(checked)
    if is_ok(checked) { assert checked.value == .left }
    let invalid = convert<ConversionSide>(0)
    assert is_err(invalid)
    if is_err(invalid) { assert invalid.error.code == "convert.invalid" }
    assert is_err(convert<NoConversionMembers>(0))
    assert is_ok(numbered_member<ConversionSide>(7))
    assert is_err(numbered_member<CmpResult>(7))
    assert convert<ConversionSide>(-9223372036854775808, invalid: .fail) == .lowest
    assert convert<ConversionSide>(7, invalid: .fail) == .right
    let plain: ConversionSide = convert<ConversionSide>(-3)
    assert plain == .next
    let nullable: ConversionSide? = convert<ConversionSide>(0)
    assert nullable == null
    assert raises("convert.invalid") { convert<ConversionSide>(0, invalid: .fail) }
}

/**
Lifted enum conversions publish names, numbers, successes and failures.
A quiet input stays quiet, and a checked error leaves the next cycle free
to publish a success under the proposed OPS-7 failure profile.

Rules:
    TYPE-7, OPS-6, OPS-7, OPS-8, FN-6

Status:
    proposed
*/
test lifted_enum_conversions {
    assert eval show_side(side: [.left, _, .right]) == ["left", _, "right"]
    assert eval number_side(side: [.next, .right]) == [-3, 7]
    assert eval traced_side(number: [-4, _, 0, 7]) == ["left", _, "convert.invalid", "right"]
    assert eval require_side(number: [-4, 7]) == [ConversionSide.left, ConversionSide.right]
    assert raises("convert.invalid") { eval require_side(number: [-4, 0]) }
}

/**
A lifted conversion to an enum without members publishes an Err for each
input tick under the proposed OPS-7 failure profile.

Rules:
    TYPE-7, OPS-7, FN-6

Status:
    proposed
*/
test lifted_empty_enum_conversion {
    assert eval observe_empty_conversion(number: [7, _, -8]) == [true, _, true]
}

/**
A forced conversion to an empty enum raises on its input's tick,
including when another conversion consumes its result, under the
proposed OPS-7 failure profile.

Rules:
    TYPE-7, OPS-7, OPS-8, FN-6

Status:
    proposed
*/
test lifted_empty_enum_failure_escapes {
    assert raises("convert.invalid") { eval require_empty_enum(number: [17]) }
    assert raises("convert.invalid") { eval show_required_empty(number: [-8]) }
}

/**
A failed conversion into a nullable empty enum publishes null, which
the next node sees as a value on each input tick. This case uses the
proposed OPS-7 failure profile.

Rules:
    TYPE-7, TYPE-14, TYPE-15, OPS-7, FN-6

Status:
    proposed
*/
test lifted_nullable_empty_enum_publishes_null {
    assert eval nullable_empty_enum(number: [7, _, -8]) == [null, _, null]
    assert eval observe_nullable_empty(number: [7, _, -8]) == [true, _, true]
}

/**
A reflected member constrained to the enum category can be the
destination of either numeric conversion policy. Both result forms
use the proposed OPS-7 failure profile.

Rules:
    GEN-3, GEN-7, GEN-17, OPS-4, OPS-6, OPS-7, OPS-8

Status:
    proposed
*/
test reflected_enum_destination {
    let checked = checked_reflected_enum(accepts_conversion_side, -4)
    assert is_ok(checked)
    if is_ok(checked) { assert checked.value == .left }
    assert forced_reflected_enum(accepts_conversion_side, 7) == .right
}
