module core part calendar

# A date moved by a tenor, on a calendar and under a rolling rule (TEN-4
# to TEN-8). Contract: spec/tenor-operations.md. The native parts are in
# hgl/native/tenors.hgl.

/**
Whether `day` is a business day of `calendar`.

A calendar is any value this operator has a value candidate for, an
`impl const fn`: core's is `Weekdays`, and a library gives its own
calendar one. `+` and `-` of a `date` and a `tenor` take a calendar as
the option `calendar`, and `Weekdays()` where none is given. A count of
business days, `2B`, counts the business days of that calendar, and a
rolling rule rolls a date onto one of them (`roll`).

Type Args:
    C: The calendar's type. It is inferred.

Args:
    calendar: The calendar asked.
    day: The date asked about.

Returns:
    True where `day` is a business day of `calendar`.

Ticks:
    - With constant arguments, `business_day(Weekdays(), @2026-01-02)`,
      the call is evaluated directly, with no timing of its own.
    - Where a graph gives it a connection, the call is lifted: each
      connection is an input, and an argument that is no connection binds
      as configuration. The result ticks in each cycle in which an input
      ticks and the call is admitted, an equal result included.

Validity:
    - Each connection given to it is valid before the call is admitted.
    - A calendar that is a struct, `Weekdays` among them, is all valid
      as well.

Examples:
    2026-01-02 is a Friday and 2026-01-03 a Saturday.

    ~~~hgl
    assert business_day(Weekdays(), @2026-01-02)
    assert !business_day(Weekdays(), @2026-01-03)
    ~~~

    In a graph, of a connection of dates: the result ticks with each
    date, the same result again included.

    ~~~hgl
    fn open_on(day: date) -> bool => business_day(Weekdays(), day)
    assert eval open_on(day: [@2026-01-02, @2026-01-02, _, @2026-01-03]) ==
        [true, true, _, false]
    ~~~

    A calendar of a library's own, with two closed days beside the
    weekend, which it asks `Weekdays()` for. This cannot run as an
    example: an example is a named test, which declares no struct and no
    candidate of its own.

    ~~~hgl no-run
    struct Holidays {
        first: date
        second: date
    }

    impl const fn business_day(calendar: Holidays, day: date) -> bool =>
        day != calendar.first && day != calendar.second && business_day(Weekdays(), day)

    test closed_days {
        let closed = Holidays(first: @2026-01-05, second: @2026-04-30)
        assert !business_day(closed, @2026-01-05)
        assert @2026-01-02 +{calendar: closed} 2B == @2026-01-07
    }
    ~~~

Rules:
    TEN-5, TEN-6, TEN-7, FN-6, FN-11, FN-12
*/
export operator business_day<C>(calendar: C, day: date) -> bool

/**
The date a rolling rule makes of `day` on `calendar`.

A rolling rule says which business day a date becomes. It is any value
this operator has a value candidate for, an `impl const fn`: core's are
the members of `Rolling`, on any calendar, and a library gives its own
rule one. `+` and `-` of a `date` and a `tenor` take one as the option
`rolling_rule`: the result is `roll(rolling_rule, calendar, moved)`,
where `moved` is the date the tenor gives and `calendar` the one the
operation has, `Weekdays()` where none is given. With no rolling rule
the result is `moved`. `Rolling` says which business day each of core's
rules gives.

Type Args:
    R: The rolling rule's type. It is inferred.
    C: The calendar's type. It is inferred.

Args:
    rolling_rule: The rule that says which business day `day` becomes.
    calendar: The calendar whose business days the rule rolls onto.
    day: The date rolled.

Returns:
    The date the rule gives for `day`.

Ticks:
    - With constant arguments, `roll(Rolling.following, Weekdays(), day)` of a constant `day`,
      the call is evaluated directly, with no timing of its own.
    - Where a graph gives it a connection, the call is lifted: each
      connection is an input, and an argument that is no connection binds
      as configuration. The result ticks in each cycle in which an input
      ticks and the call is admitted, an equal result included.

Validity:
    - Each connection given to it is valid before the call is admitted.
    - A calendar that is a struct, `Weekdays` among them, is all valid
      as well.

Examples:
    2026-01-03 is a Saturday, and 2026-01-31 the last Saturday of
    January.

    ~~~hgl
    assert roll(Rolling.following, Weekdays(), @2026-01-03) == @2026-01-05
    assert roll(Rolling.preceding, Weekdays(), @2026-01-03) == @2026-01-02
    assert roll(Rolling.modified_following, Weekdays(), @2026-01-31) == @2026-01-30
    ~~~

    As the option of `+`, on the date the tenor gives.

    ~~~hgl
    assert @2026-01-31 +{rolling_rule: Rolling.modified_following} 0D == @2026-01-30
    assert @2026-01-31 + 0D == @2026-01-31
    ~~~

    In a graph, of a connection of dates: the result ticks with each
    date, the same result again included.

    ~~~hgl
    fn rolled_on(day: date) -> date => roll(Rolling.following, Weekdays(), day)
    assert eval rolled_on(day: [@2026-01-03, @2026-01-04, _, @2026-01-05]) ==
        [@2026-01-05, @2026-01-05, _, @2026-01-05]
    ~~~

Rules:
    TEN-5, TEN-7, TEN-8, FN-6, FN-11, FN-12
*/
export operator roll<R, C>(rolling_rule: R, calendar: C, day: date) -> date

/**
Core's four rolling rules, each of which `roll` takes on any calendar.

Each makes a date a business day of the calendar; a date that is one
already is left as it is.

| Member | The business day a date becomes |
| --- | --- |
| `following` | The one on or after it |
| `preceding` | The one on or before it |
| `modified_following` | The one on or after it, or where that is in another month the one on or before |
| `modified_preceding` | The one on or before it, or where that is in another month the one on or after |

Examples:
    2026-01-31 is a Saturday, and 2026-02-01 a Sunday.

    ~~~hgl
    assert @2026-01-31 +{rolling_rule: Rolling.following} 0D == @2026-02-02
    assert @2026-01-31 +{rolling_rule: Rolling.modified_following} 0D == @2026-01-30
    assert @2026-02-01 +{rolling_rule: Rolling.preceding} 0D == @2026-01-30
    assert @2026-02-01 +{rolling_rule: Rolling.modified_preceding} 0D == @2026-02-02
    ~~~

Rules:
    TEN-7, TEN-8
*/
export enum Rolling {
    /**
    The business day on or after the date.

    Examples:
        2026-01-03 is a Saturday.

        ~~~hgl
        assert roll(Rolling.following, Weekdays(), @2026-01-03) == @2026-01-05
        assert roll(Rolling.following, Weekdays(), @2026-01-05) == @2026-01-05
        ~~~

    Rules:
        TEN-8
    */
    following,
    /**
    The business day on or after the date, or where that is in another month the one on or before.

    Examples:
        2026-01-31 is a Saturday, and the business day after it is in February.

        ~~~hgl
        assert roll(Rolling.modified_following, Weekdays(), @2026-01-03) == @2026-01-05
        assert roll(Rolling.modified_following, Weekdays(), @2026-01-31) == @2026-01-30
        ~~~

    Rules:
        TEN-8
    */
    modified_following,
    /**
    The business day on or before the date.

    Examples:
        2026-01-03 is a Saturday.

        ~~~hgl
        assert roll(Rolling.preceding, Weekdays(), @2026-01-03) == @2026-01-02
        assert roll(Rolling.preceding, Weekdays(), @2026-01-02) == @2026-01-02
        ~~~

    Rules:
        TEN-8
    */
    preceding,
    /**
    The business day on or before the date, or where that is in another month the one on or after.

    Examples:
        2026-01-04 is a Sunday, and the business day before it, 2026-01-02,
        is in its month. 2026-02-01 is a Sunday too, and the business day
        before it is in January.

        ~~~hgl
        assert roll(Rolling.modified_preceding, Weekdays(), @2026-01-04) == @2026-01-02
        assert roll(Rolling.modified_preceding, Weekdays(), @2026-02-01) == @2026-02-02
        ~~~

    Rules:
        TEN-8
    */
    modified_preceding,
}

/**
The calendar on which every day but a Saturday and a Sunday is a business day.

It is the calendar a date is moved on where `+` or `-` of a `date` and a
`tenor` is given none, and the one a rolling rule rolls onto then. It
has no field, and is written `Weekdays()`. A calendar of a library's own
may ask it for the weekend, `business_day(Weekdays(), day)`.

Examples:
    2026-01-02 is a Friday and 2026-01-05 the Monday after it.

    ~~~hgl
    assert business_day(Weekdays(), @2026-01-05)
    assert !business_day(Weekdays(), @2026-01-04)
    assert @2026-01-02 + 1B == @2026-01-05
    assert @2026-01-02 +{calendar: Weekdays()} 1B == @2026-01-05
    ~~~

Rules:
    TEN-5, TEN-6, TEN-7
*/
export struct Weekdays {}

impl const fn business_day(calendar: Weekdays, day: date) -> bool => !weekend(day)

# The business day of `calendar` on or after `day`.
const fn on_or_after<C>(day: date, calendar: C) -> date
    requires business_day(C, date) -> bool {
    var at: date = day
    while !business_day(calendar, at) {
        at = moved(at, 1D)
    }
    return at
}

# The business day of `calendar` on or before `day`.
const fn on_or_before<C>(day: date, calendar: C) -> date
    requires business_day(C, date) -> bool {
    var at: date = day
    while !business_day(calendar, at) {
        at = moved(at, -1D)
    }
    return at
}

# TEN-6: the business day `count` business days after the one on or after
# `day`, for a count that is not negative.
const fn business_days_on<C>(day: date, count: i64, calendar: C) -> date
    requires business_day(C, date) -> bool {
    var at: date = on_or_after(day, calendar)
    var left: i64 = count
    while left > 0 {
        at = moved(at, 1D)
        if business_day(calendar, at) { left -= 1 }
    }
    return at
}

# TEN-6: the business day `count` business days before the one on or
# before `day`, for a count that is not negative.
const fn business_days_back<C>(day: date, count: i64, calendar: C) -> date
    requires business_day(C, date) -> bool {
    var at: date = on_or_before(day, calendar)
    var left: i64 = count
    while left > 0 {
        at = moved(at, -1D)
        if business_day(calendar, at) { left -= 1 }
    }
    return at
}

# TEN-4, TEN-6: `day + by`.
const fn moved_on<C>(day: date, by: tenor, calendar: C) -> date
    requires business_day(C, date) -> bool {
    let count = business_days(by)
    if count != null {
        if count < 0 { return business_days_back(day, -count, calendar) }
        return business_days_on(day, count, calendar)
    }
    return moved(day, by)
}

# TEN-4, TEN-6: `day - by`.
const fn moved_back<C>(day: date, by: tenor, calendar: C) -> date
    requires business_day(C, date) -> bool {
    let count = business_days(by)
    if count != null {
        if count < 0 { return business_days_on(day, -count, calendar) }
        return business_days_back(day, count, calendar)
    }
    return moved(day, -by)
}

# TEN-1, TEN-7: `date + tenor` and `date - tenor`. `calendar` and
# `rolling_rule` are options, each declared by the candidates that take it.
impl const fn add_(lhs: date, rhs: tenor) -> date => moved_on(lhs, rhs, Weekdays())

impl const fn add_<C>(lhs: date, rhs: tenor, calendar: C) -> date
    requires business_day(C, date) -> bool => moved_on(lhs, rhs, calendar)

impl const fn add_<R>(lhs: date, rhs: tenor, rolling_rule: R) -> date
    requires roll(R, Weekdays, date) -> date =>
    roll(rolling_rule, Weekdays(), moved_on(lhs, rhs, Weekdays()))

impl const fn add_<R, C>(lhs: date, rhs: tenor, rolling_rule: R, calendar: C) -> date
    requires roll(R, C, date) -> date && business_day(C, date) -> bool =>
    roll(rolling_rule, calendar, moved_on(lhs, rhs, calendar))

impl const fn sub_(lhs: date, rhs: tenor) -> date => moved_back(lhs, rhs, Weekdays())

impl const fn sub_<C>(lhs: date, rhs: tenor, calendar: C) -> date
    requires business_day(C, date) -> bool => moved_back(lhs, rhs, calendar)

impl const fn sub_<R>(lhs: date, rhs: tenor, rolling_rule: R) -> date
    requires roll(R, Weekdays, date) -> date =>
    roll(rolling_rule, Weekdays(), moved_back(lhs, rhs, Weekdays()))

impl const fn sub_<R, C>(lhs: date, rhs: tenor, rolling_rule: R, calendar: C) -> date
    requires roll(R, C, date) -> date && business_day(C, date) -> bool =>
    roll(rolling_rule, calendar, moved_back(lhs, rhs, calendar))

# TEN-2: a tenor scaled, in the other order.
impl const fn mul_(lhs: i64, rhs: tenor) -> tenor => mul_(rhs, lhs)

# TEN-8: core's rolling rules, on any calendar. Each looks only the way
# its rule needs: a calendar may have no business day the other way.
impl const fn roll<C>(rolling_rule: Rolling, calendar: C, day: date) -> date
    requires business_day(C, date) -> bool {
    switch rolling_rule {
        case .following: return on_or_after(day, calendar)
        case .preceding: return on_or_before(day, calendar)
        case .modified_following:
            let after = on_or_after(day, calendar)
            if same_month(after, day) { return after }
            return on_or_before(day, calendar)
        case .modified_preceding:
            let before = on_or_before(day, calendar)
            if same_month(before, day) { return before }
            return on_or_after(day, calendar)
    }
}
