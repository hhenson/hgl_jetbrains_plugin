fn type_query_temporal_call(value: i64) -> i64 => value

/**
An unevaluated Type query does not admit a temporal call in a value function.
The call keeps the source rejection of the place in which it is written.

Rules:
    TYPE-18, FN-3

Status:
    agreed
*/
const fn temporal_call_in_a_value_type_query() -> Type {
    # expect-error(function-kind, "call.role")
    return type(type_query_temporal_call(1))
}
