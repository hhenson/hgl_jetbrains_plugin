module conformance part window_ticks

# A window of three values at most and two at least, of each reading.
fn collect_readings(reading: i64) -> rolling_window<i64, 3, 2> {
    when { return reading }
}

fn window_validity(probe: bool, readings: rolling_window<i64, 3, 2>) -> list<bool, 2> {
    when modified(probe) && valid([]) { return [valid(readings), all_valid(readings)] }
}

fn observe_window_validity(probe: bool, reading: i64) -> list<bool, 2> =>
    window_validity(probe, collect_readings(reading))

/**
A window is valid once it holds a value, and all valid once it holds its minimum.
The first reading arrives on the second cycle and the second on the
fourth; the probe reads the window every cycle. Each tick is
`[valid, all_valid]`.

:Rules: TYPE-11, TIME-9, END-9
:Status: agreed
*/
test a_window_is_valid_before_its_minimum_and_all_valid_at_it {
    assert eval observe_window_validity(
        probe:   [true, true, true, true],
        reading: [   _,    1,    _,    2],
    ) == [[false, false], [true, false], [true, false], [true, true]]
}

fn total_when_all_valid(readings: rolling_window<i64, 3, 2>) -> i64 {
    when all_valid(readings) { return sum_readings(readings) }
}

fn total_when_valid(readings: rolling_window<i64, 3, 2>) -> i64 {
    when { return sum_readings(readings) }
}

fn ready_total(reading: i64) -> i64 => total_when_all_valid(collect_readings(reading))

fn early_total(reading: i64) -> i64 => total_when_valid(collect_readings(reading))

/**
A read of a window's value before it is all valid fails.
Under `all_valid` the read waits for the second reading, and the fourth
drops the first: the totals are 3, 6 and 9. Under ordinary validity the
first reading is read alone, and the run fails with `value.unset_read`.
A window's value is read as a `list<V>` of the values held, oldest first.

:Rules: TYPE-11, END-9, CEVAL-6
:Status: agreed
*/
test reading_a_window_before_it_is_all_valid_fails {
    assert eval ready_total(reading: [1, 2, 3, 4]) == [_, 3, 6, 9]
    assert raises("value.unset_read") {
        eval early_total(reading: [1, 2])
    }
}

fn checked_window_readings(readings: rolling_window<i64, 3, 2>) -> result<list<i64>, error> {
    when { return readings }
}

const fn window_outcome_code(outcome: result<list<i64>, error>) -> str {
    if is_ok(outcome) { return "ok" }
    let code = outcome.error.code
    if code == null { return "no code" }
    return code
}

fn window_outcome(reading: i64) -> str =>
    window_outcome_code(checked_window_readings(collect_readings(reading)))

/**
A `result` accepts the read of a window before it is all valid as an error.
The first reading leaves the window below its minimum of two: reading it
gives an error coded `value.unset_read`, and the node does not fail. The
second reading makes it all valid.

:Rules: TYPE-11, ERR-14, END-9
:Status: agreed
*/
test a_result_accepts_the_read_of_a_window_before_it_is_all_valid {
    assert eval window_outcome(reading: [1, 2]) == ["value.unset_read", "ok"]
}

const fn total_or_zero(readings: list<i64> = []) -> i64 => sum_readings(readings)

fn defaulted_total(reading: i64) -> i64 => total_or_zero(collect_readings(reading))

/**
A lifted parameter's default is not bound for a window below its minimum.
The default binds for an input that is not valid. After the first reading
the window is valid and not all valid: the helper is not invoked, and no 0
is published. From the second reading the totals are 3 and 6.

:Rules: FN-11, FN-12, TYPE-11, END-9
:Status: agreed
*/
test a_default_does_not_stand_for_a_window_below_its_minimum {
    assert eval defaulted_total(reading: [1, 2, 3]) == [_, 3, 6]
}

# A window of 3us at most and 1us at least, of each reading.
fn collect_recent(reading: i64) -> rolling_window<i64, 3us, 1us> {
    when { return reading }
}

fn readiness_at_tick(readings: rolling_window<i64, 3us, 1us>) -> bool {
    when modified(readings) { return all_valid(readings) }
}

fn observe_recent_readiness(reading: i64) -> bool =>
    readiness_at_tick(collect_recent(reading))

/**
A value leaves a window of a duration once it is older than the duration, and the window ticks then.
The reader is woken by the window alone, and publishes `all_valid`. The
readings arrive at 0us and 1us, and nothing arrives after. The first, of
age 3us at 3us, is held then, and leaves at 4us, when the window falls
under its minimum of 1us; the second leaves at 5us.

:Rules: TYPE-11, TIME-3, END-9
:Status: agreed
*/
test a_value_leaves_a_window_of_a_duration_with_a_tick {
    assert eval observe_recent_readiness(reading: [1, 2]) ==
        [false, true, _, _, false, false]
}

# A window of 4us at most and 2us at least, of each reading.
fn collect_spanned(reading: i64) -> rolling_window<i64, 4us, 2us> {
    when { return reading }
}

fn spanned_validity(probe: bool, readings: rolling_window<i64, 4us, 2us>) -> list<bool, 2> {
    when modified(probe) && valid([]) { return [valid(readings), all_valid(readings)] }
}

fn observe_spanned_validity(probe: bool, reading: i64) -> list<bool, 2> =>
    spanned_validity(probe, collect_spanned(reading))

/**
A window of a duration is all valid while the values held span its minimum, and not after.
The readings arrive at 0us, 1us and 2us, and the probe reads the window
every cycle. From 2us the readings span the minimum of 2us, and time
passing changes nothing until, at 5us, the first leaves: the two held
span 1us. Each tick is `[valid, all_valid]`.

:Rules: TYPE-11, TIME-9, END-9
:Status: agreed
*/
test a_window_of_a_duration_falls_back_under_its_minimum {
    assert eval observe_spanned_validity(
        probe:   [true, true, true, true, true, true],
        reading: [   1,    2,    3,    _,    _,    _],
    ) == [[true, false], [true, false], [true, true], [true, true], [true, true], [true, false]]
}

# A window of 3us at most with a minimum of zero, of each reading.
fn collect_any(reading: i64) -> rolling_window<i64, 3us, 0s> {
    when { return reading }
}

fn total_at_tick(readings: rolling_window<i64, 3us, 0s>) -> i64 {
    when modified(readings) {
        if all_valid(readings) { return sum_readings(readings) }
        return -1
    }
}

fn observe_any_total(reading: i64) -> i64 => total_at_tick(collect_any(reading))

/**
A window of a duration with a minimum of zero is all valid from its first value, and not once empty.
The reader is woken by the window alone, and publishes the total of the
readings held where the window is all valid, else -1. The readings arrive
at 0us and 1us, and each leaves 4us after it arrives: at 4us the window
holds the second alone, and at 5us it is empty.

:Rules: TYPE-11, END-9
:Status: agreed
*/
test a_zero_minimum_is_held_by_the_first_value {
    assert eval observe_any_total(reading: [1, 2]) == [1, 3, _, _, 2, -1]
}

fn validity_at_tick(readings: rolling_window<i64, 3us, 1us>) -> list<bool, 2> {
    when modified(readings) { return [valid(readings), all_valid(readings)] }
}

fn observe_recent_validity(reading: i64) -> list<bool, 2> =>
    validity_at_tick(collect_recent(reading))

/**
A window of a duration emptied by exits stays valid, and is not all valid.
The one reading arrives at 0us and leaves at 4us, and the reader is woken
by the window alone. Each tick is `[valid, all_valid]`.

:Rules: TYPE-11, END-9
:Status: agreed
*/
test a_window_emptied_by_exits_stays_valid {
    assert eval observe_recent_validity(reading: [1]) ==
        [[true, false], _, _, _, [true, false]]
}

# A window of two values, of each reading.
fn collect_pair(reading: i64) -> rolling_window<i64, 2> {
    when { return reading }
}

# A result's value as text, or its error's code.
const fn value_or_code(outcome: result<i64, error>) -> str {
    if is_ok(outcome) { return convert<str>(outcome.value) }
    let code = outcome.error.code
    if code == null { return "no code" }
    return code
}

fn pair_change(readings: rolling_window<i64, 2>) -> tuple<i64, str> {
    when modified(readings) {
        return (delta_value(readings), value_or_code(removed_value(readings)))
    }
}

fn observe_pair_changes(reading: i64) -> tuple<i64, str> =>
    pair_change(collect_pair(reading))

/**
An arrival at a full window of ticks pushes the oldest value out, and `removed_value` is that value.
The window holds two readings. Each tick is the delta, read plainly, and
`removed_value` read as a result, as its value or its error's code. Until
the window is full no value leaves it; the third reading pushes the first
out.

:Rules: TYPE-11, TYPE-16, ERR-14, END-3, END-9
:Status: agreed
*/
test an_arrival_at_a_full_window_of_ticks_pushes_out_its_oldest_value {
    assert eval observe_pair_changes(reading: [1, 2, 3]) ==
        [(1, "value.unset_read"), (2, "value.unset_read"), (3, "1")]
}

fn recent_change(readings: rolling_window<i64, 3us, 1us>) -> list<str, 2> {
    when modified(readings) {
        return [value_or_code(delta_value(readings)), value_or_code(removed_value(readings))]
    }
}

fn observe_recent_changes(reading: i64) -> list<str, 2> =>
    recent_change(collect_recent(reading))

/**
A window of a duration has no delta where a value only leaves it, and `removed_value` is the value that left.
Each tick is the delta and `removed_value`, each read as a result, as its
value or its error's code. The readings of 1 and 2 arrive at 0us and
1us. The 1 leaves at 4us with nothing arriving, and the 3 arrives at 5us
as the 2 leaves: one tick, with both. The run ends before the 3 leaves.

:Rules: TYPE-11, TYPE-16, ERR-14, END-3, END-9
:Status: agreed
*/
test a_window_of_a_duration_has_no_delta_where_a_value_only_leaves {
    assert eval{length: 6us} observe_recent_changes(reading: [1, 2, _, _, _, 3]) == [
        ["1", "value.unset_read"],
        ["2", "value.unset_read"],
        _,
        _,
        ["value.unset_read", "1"],
        ["3", "2"],
    ]
}

fn held_at_tick(readings: rolling_window<i64, 3us, 0s>) -> list<i64> {
    when modified(readings) {
        if all_valid(readings) { return readings }
        return []
    }
}

fn observe_held(reading: i64) -> list<i64> => held_at_tick(collect_any(reading))

/**
A recording of a window of a duration holds its arrivals, and replaying them gives the same window.
The readings of 1 and 2 arrive at 0us and 1us, and leave at 4us and 5us
with nothing arriving: the recording of the window has no entry for
either exit. Given that recording as its input, the reader sees what it
sees of the window the readings make, cycle by cycle: the values held,
and an empty list once none is.

:Rules: TYPE-11, TST-16, CEVAL-3, CEVAL-4, END-9
:Status: agreed
*/
test a_recording_of_a_window_holds_its_arrivals_and_replays_the_same_window {
    assert eval collect_any(reading: [1, 2]) == [1, 2]
    assert eval observe_held(reading: [1, 2]) == [[1], [1, 2], _, _, [2], []]
    assert eval held_at_tick(readings: [1, 2]) == [[1], [1, 2], _, _, [2], []]
}
