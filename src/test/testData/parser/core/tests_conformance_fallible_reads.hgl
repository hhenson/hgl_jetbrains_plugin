module conformance part fallible_reads

const fn checked_result(value: i64) -> result<i64, error> {
    if value == 0 { return err(error(message: "zero divisor", code: "numeric.division_by_zero")) }
    return ok(value)
}

const fn read_checked(value: i64) -> i64 => checked_result(value)

const fn read_nullable_result(value: i64) -> i64? => checked_result(value)

/**
A fallible result can be kept whole, used as its value, or taken as a
nullable value. An inferred local preserves the result's failure code.

Rules:
    ERR-5, ERR-15

Status:
    agreed
*/
test a_value_place_selects_the_result_form {
    let held = checked_result(0)
    assert is_err(held)
    if is_err(held) { assert held.error.code == "numeric.division_by_zero" }
    let successful: i64 = checked_result(7)
    assert successful == 7
    let absent: i64? = held
    assert absent == null
    assert read_nullable_result(0) == null
    assert read_nullable_result(7) == 7
    assert raises("numeric.division_by_zero") { read_checked(0) }
}

const fn rethrow_held(value: i64) -> result<i64, error> {
    let held = checked_result(value)
    let successful: i64 = held
    return ok(successful)
}

/**
A value function returning a result keeps the original error when a
place asks for the value of a held failure.

Rules:
    ERR-5, ERR-15

Status:
    agreed
*/
test a_held_failure_returns_the_same_error {
    let held = rethrow_held(0)
    assert is_err(held)
    if is_err(held) { assert held.error.code == "numeric.division_by_zero" }
}

const fn nullable_payload(failing: bool, value: i64?) -> result<i64?, error> {
    if failing && value == null { return err(error(message: "missing input", code: "value.null")) }
    return ok(value)
}

const fn take_nullable_payload(failing: bool, value: i64?) -> i64? =>
    nullable_payload(failing, value)

/**
When the success type is nullable, a place of that type takes the success
payload. A success that holds null remains distinct from a failure.

Rules:
    ERR-5, ERR-15

Status:
    agreed
*/
test a_nullable_success_is_distinct_from_a_failure {
    assert take_nullable_payload(false, null) == null
    assert take_nullable_payload(false, 7) == 7
    assert raises("value.null") { take_nullable_payload(true, null) }
}

fn whole_result(value: i64) -> result<i64, error> => checked_result(value)

fn composed_result_value(value: i64) -> i64 => checked_result(value)

fn composed_result_nullable(value: i64) -> i64? => checked_result(value)

fn composed_held_nullable(value: i64) -> i64? {
    let held = checked_result(value)
    return held
}

/**
A lifted call whose place takes the result publishes an outcome for
each input, including failure as data.

Rules:
    ERR-15, FN-6

Status:
    agreed
*/
test a_composed_call_can_publish_its_whole_result {
    assert eval whole_result(value: [7, 0]) ==
        [ok(7), err(error(message: "zero divisor", code: "numeric.division_by_zero"))]
}

/**
When a connection of the success type is taken, a failed call raises
at its node instead of publishing that outcome.

Rules:
    ERR-5, ERR-15, FN-6

Status:
    agreed
*/
test a_composed_call_can_raise_at_its_node {
    assert eval composed_result_value(value: [7]) == [7]
    assert raises("numeric.division_by_zero") { eval composed_result_value(value: [7, 0]) }
}

/**
A connection taken as nullable publishes null on failure, whether it is
the call's connection or a result held by a binding.

Rules:
    ERR-15, FN-6

Status:
    agreed
*/
test a_composed_result_can_publish_null_on_failure {
    assert eval composed_result_nullable(value: [7, 0, 8]) == [7, null, 8]
    assert eval composed_held_nullable(value: [7, 0, 8]) == [7, null, 8]
}

const fn read_nullable_value(value: i64?) -> i64 => value

const fn capture_null_read(value: i64?) -> result<i64, error> {
    let read: i64 = value
    return ok(read)
}

fn read_nullable_connection(value: i64?) -> i64 => read_nullable_value(value)

/**
A nullable read succeeds for a present value and fails with value.null
for null, both in value code and when a connection is read.

Rules:
    ERR-5, ERR-12, FN-11

Status:
    agreed
*/
test a_null_read_fails_with_value_null {
    assert read_nullable_value(8) == 8
    assert raises("value.null") { read_nullable_value(null) }
    let absent = capture_null_read(null)
    assert is_err(absent)
    if is_err(absent) { assert absent.error.code == "value.null" }
    assert eval read_nullable_connection(value: [8, 9]) == [8, 9]
    assert raises("value.null") { eval read_nullable_connection(value: [8, null]) }
}

const fn checked_optional(value: i64) -> result<i64?, error> {
    if value < 0 { return err(error(message: "negative index", code: "value.index_out_of_range")) }
    if value == 0 { return ok(null) }
    return ok(value)
}

const fn read_checked_optional(value: i64) -> i64 => checked_optional(value)

fn read_checked_optional_connection(value: i64) -> i64 => checked_optional(value)

/**
A value place that asks for an i64 reads a fallible nullable success.
A positive value is present, zero gives a successful null, and a negative
input raises the original error.

Rules:
    ERR-5, ERR-12, ERR-15

Status:
    agreed
*/
test a_value_place_reads_a_fallible_nullable_success {
    assert read_checked_optional(8) == 8
    assert raises("value.null") { read_checked_optional(0) }
    assert raises("value.index_out_of_range") { read_checked_optional(-1) }
}

/**
A non-nullable connection publishes the present successes of a fallible
nullable connection. A successful null raises value.null, and a failed
result raises its original error.

Rules:
    ERR-5, ERR-12, ERR-15, FN-6

Status:
    agreed
*/
test a_connection_reads_a_fallible_nullable_success {
    assert eval read_checked_optional_connection(value: [8, 9]) == [8, 9]
    assert raises("value.null") { eval read_checked_optional_connection(value: [8, 0]) }
    assert raises("value.index_out_of_range") { eval read_checked_optional_connection(value: [8, -1]) }
}
