module core part scalar_operators

# Native value candidates of core's scalar operators (NUM-1, OPS-1, OPS-2).
# A provider supplies each body; core/core.hgl supplies reverse-order
# candidates for commutative operations. An option is declared by the
# candidates that use it: one that selects the result type, `zero` and
# `invalid`, as a generic value parameter, and any other as a parameter.

# NUM-1: `+`, `-`, `*` on numbers. Two `i64` give an `i64`; an `f64` among
# the operands gives an `f64`.
native impl const fn add_(lhs: i64, rhs: i64) -> i64
native impl const fn add_(lhs: f64, rhs: f64) -> f64
native impl const fn add_(lhs: i64, rhs: f64) -> f64
native impl const fn sub_(lhs: i64, rhs: i64) -> i64
native impl const fn sub_(lhs: f64, rhs: f64) -> f64
native impl const fn sub_(lhs: i64, rhs: f64) -> f64
native impl const fn sub_(lhs: f64, rhs: i64) -> f64
native impl const fn mul_(lhs: i64, rhs: i64) -> i64
native impl const fn mul_(lhs: f64, rhs: f64) -> f64
native impl const fn mul_(lhs: i64, rhs: f64) -> f64

# NUM-3, NUM-9, NUM-12: every division takes `zero`. One whose result is an
# `f64` admits every policy and defaults to `.ieee`; one whose result holds no
# infinity or NaN admits `.error` and `.fail`, and defaults to `.fail`. Under
# `.error` the result is a `result` of what it otherwise is.

# NUM-1: `/` is an `f64`.
native impl const fn div_<const zero: ZeroPolicy = .ieee>(lhs: i64, rhs: i64) -> f64
    requires zero in {.ieee, .nan, .fail}
native impl const fn div_<const zero: ZeroPolicy>(lhs: i64, rhs: i64) -> result<f64, error>
    requires zero == .error
native impl const fn div_<const zero: ZeroPolicy = .ieee>(lhs: f64, rhs: f64) -> f64
    requires zero in {.ieee, .nan, .fail}
native impl const fn div_<const zero: ZeroPolicy>(lhs: f64, rhs: f64) -> result<f64, error>
    requires zero == .error
native impl const fn div_<const zero: ZeroPolicy = .ieee>(lhs: i64, rhs: f64) -> f64
    requires zero in {.ieee, .nan, .fail}
native impl const fn div_<const zero: ZeroPolicy>(lhs: i64, rhs: f64) -> result<f64, error>
    requires zero == .error
native impl const fn div_<const zero: ZeroPolicy = .ieee>(lhs: f64, rhs: i64) -> f64
    requires zero in {.ieee, .nan, .fail}
native impl const fn div_<const zero: ZeroPolicy>(lhs: f64, rhs: i64) -> result<f64, error>
    requires zero == .error

# NUM-1: `//` and `%` are an `i64` of two `i64`, and an `f64` otherwise.
native impl const fn floordiv_<const zero: ZeroPolicy = .fail>(lhs: i64, rhs: i64) -> i64
    requires zero == .fail
native impl const fn floordiv_<const zero: ZeroPolicy>(lhs: i64, rhs: i64) -> result<i64, error>
    requires zero == .error
native impl const fn floordiv_<const zero: ZeroPolicy = .ieee>(lhs: f64, rhs: f64) -> f64
    requires zero in {.ieee, .nan, .fail}
native impl const fn floordiv_<const zero: ZeroPolicy>(lhs: f64, rhs: f64) -> result<f64, error>
    requires zero == .error
native impl const fn floordiv_<const zero: ZeroPolicy = .ieee>(lhs: i64, rhs: f64) -> f64
    requires zero in {.ieee, .nan, .fail}
native impl const fn floordiv_<const zero: ZeroPolicy>(lhs: i64, rhs: f64) -> result<f64, error>
    requires zero == .error
native impl const fn floordiv_<const zero: ZeroPolicy = .ieee>(lhs: f64, rhs: i64) -> f64
    requires zero in {.ieee, .nan, .fail}
native impl const fn floordiv_<const zero: ZeroPolicy>(lhs: f64, rhs: i64) -> result<f64, error>
    requires zero == .error
native impl const fn mod_<const zero: ZeroPolicy = .fail>(lhs: i64, rhs: i64) -> i64
    requires zero == .fail
native impl const fn mod_<const zero: ZeroPolicy>(lhs: i64, rhs: i64) -> result<i64, error>
    requires zero == .error
native impl const fn mod_<const zero: ZeroPolicy = .ieee>(lhs: f64, rhs: f64) -> f64
    requires zero in {.ieee, .nan, .fail}
native impl const fn mod_<const zero: ZeroPolicy>(lhs: f64, rhs: f64) -> result<f64, error>
    requires zero == .error
native impl const fn mod_<const zero: ZeroPolicy = .ieee>(lhs: i64, rhs: f64) -> f64
    requires zero in {.ieee, .nan, .fail}
native impl const fn mod_<const zero: ZeroPolicy>(lhs: i64, rhs: f64) -> result<f64, error>
    requires zero == .error
native impl const fn mod_<const zero: ZeroPolicy = .ieee>(lhs: f64, rhs: i64) -> f64
    requires zero in {.ieee, .nan, .fail}
native impl const fn mod_<const zero: ZeroPolicy>(lhs: f64, rhs: i64) -> result<f64, error>
    requires zero == .error

# NUM-1: unary `-` keeps the numeric type. OPS-1: a duration's.
native impl const fn neg_(value: i64) -> i64
native impl const fn neg_(value: f64) -> f64
native impl const fn neg_(value: duration) -> duration

# OPS-1: `+`.
native impl const fn add_(lhs: str, rhs: str) -> str
native impl const fn add_(lhs: duration, rhs: duration) -> duration
native impl const fn add_(lhs: datetime, rhs: duration) -> datetime
native impl const fn add_(lhs: date, rhs: duration) -> civil_datetime
native impl const fn add_(lhs: civil_datetime, rhs: duration) -> civil_datetime
native impl const fn add_(lhs: zoned_datetime, rhs: duration) -> zoned_datetime
native impl const fn add_(lhs: date, rhs: time) -> civil_datetime

# OPS-1: `-`. An instant less a duration; two instants of one type. A date
# and a duration give a civil datetime, here and in `+` (OPS-10).
native impl const fn sub_(lhs: duration, rhs: duration) -> duration
native impl const fn sub_(lhs: datetime, rhs: duration) -> datetime
native impl const fn sub_(lhs: date, rhs: duration) -> civil_datetime
native impl const fn sub_(lhs: civil_datetime, rhs: duration) -> civil_datetime
native impl const fn sub_(lhs: zoned_datetime, rhs: duration) -> zoned_datetime
native impl const fn sub_(lhs: datetime, rhs: datetime) -> duration
native impl const fn sub_(lhs: date, rhs: date) -> duration
native impl const fn sub_(lhs: civil_datetime, rhs: civil_datetime) -> duration

# OPS-1: `*`, `/`, `//` on durations and strings.
native impl const fn mul_(lhs: duration, rhs: i64) -> duration
native impl const fn mul_(lhs: duration, rhs: f64) -> duration
# OPS-1: the text repeated `rhs` times. A count below zero is an HGL error
# with code `numeric.out_of_range`.
native impl const fn mul_(lhs: str, rhs: i64) -> str
native impl const fn div_<const zero: ZeroPolicy = .fail>(lhs: duration, rhs: i64) -> duration
    requires zero == .fail
native impl const fn div_<const zero: ZeroPolicy>(lhs: duration, rhs: i64) -> result<duration, error>
    requires zero == .error
native impl const fn div_<const zero: ZeroPolicy = .fail>(lhs: duration, rhs: f64) -> duration
    requires zero == .fail
native impl const fn div_<const zero: ZeroPolicy>(lhs: duration, rhs: f64) -> result<duration, error>
    requires zero == .error
native impl const fn div_<const zero: ZeroPolicy = .ieee>(lhs: duration, rhs: duration) -> f64
    requires zero in {.ieee, .nan, .fail}
native impl const fn div_<const zero: ZeroPolicy>(lhs: duration, rhs: duration) -> result<f64, error>
    requires zero == .error
native impl const fn floordiv_<const zero: ZeroPolicy = .fail>(lhs: duration, rhs: duration) -> i64
    requires zero == .fail
native impl const fn floordiv_<const zero: ZeroPolicy>(lhs: duration, rhs: duration) -> result<i64, error>
    requires zero == .error

# OPS-2: `==` and `!=` compare two values of one type. NUM-4 and NUM-11: numbers
# compare exactly, an `i64` with an `f64` included, or within the tolerances
# configured by `abs` and `rel`, each zero unless given.
native impl const fn eq_<T>(lhs: T, rhs: T) -> bool
native impl const fn eq_{abs: f64 = 0.0, rel: f64 = 0.0}(lhs: i64, rhs: i64) -> bool
native impl const fn eq_{abs: f64 = 0.0, rel: f64 = 0.0}(lhs: f64, rhs: f64) -> bool
native impl const fn eq_{abs: f64 = 0.0, rel: f64 = 0.0}(lhs: i64, rhs: f64) -> bool
native impl const fn ne_<T>(lhs: T, rhs: T) -> bool
native impl const fn ne_{abs: f64 = 0.0, rel: f64 = 0.0}(lhs: i64, rhs: i64) -> bool
native impl const fn ne_{abs: f64 = 0.0, rel: f64 = 0.0}(lhs: f64, rhs: f64) -> bool
native impl const fn ne_{abs: f64 = 0.0, rel: f64 = 0.0}(lhs: i64, rhs: f64) -> bool

# OPS-2: two zoned datetimes are equal by instant and zone name, or with
# `utc` by instant alone.
native impl const fn eq_(lhs: zoned_datetime, rhs: zoned_datetime, utc: bool = false) -> bool
native impl const fn ne_(lhs: zoned_datetime, rhs: zoned_datetime, utc: bool = false) -> bool

# OPS-2, TYPE-1: the ordered types, with unsigned octet ordering for bytes.
# NUM-6: numbers, an `i64` with an `f64` included.
native impl const fn lt_<T>(lhs: T, rhs: T) -> bool
    requires T in {i64, f64, str, bool, date, time, datetime, civil_datetime, duration}
native impl const fn lt_(lhs: bytes, rhs: bytes) -> bool
native impl const fn lt_(lhs: i64, rhs: f64) -> bool
native impl const fn lt_(lhs: f64, rhs: i64) -> bool
native impl const fn le_<T>(lhs: T, rhs: T) -> bool
    requires T in {i64, f64, str, bool, date, time, datetime, civil_datetime, duration}
native impl const fn le_(lhs: bytes, rhs: bytes) -> bool
native impl const fn le_(lhs: i64, rhs: f64) -> bool
native impl const fn le_(lhs: f64, rhs: i64) -> bool
native impl const fn gt_<T>(lhs: T, rhs: T) -> bool
    requires T in {i64, f64, str, bool, date, time, datetime, civil_datetime, duration}
native impl const fn gt_(lhs: bytes, rhs: bytes) -> bool
native impl const fn gt_(lhs: i64, rhs: f64) -> bool
native impl const fn gt_(lhs: f64, rhs: i64) -> bool
native impl const fn ge_<T>(lhs: T, rhs: T) -> bool
    requires T in {i64, f64, str, bool, date, time, datetime, civil_datetime, duration}
native impl const fn ge_(lhs: bytes, rhs: bytes) -> bool
native impl const fn ge_(lhs: i64, rhs: f64) -> bool
native impl const fn ge_(lhs: f64, rhs: i64) -> bool

# OPS-3: `<=>` returns the outcome.
native impl const fn compare_<T>(lhs: T, rhs: T) -> CmpResult
    requires T in {i64, f64, str, bool, date, time, datetime, civil_datetime, duration}
native impl const fn compare_(lhs: bytes, rhs: bytes) -> CmpResult
native impl const fn compare_(lhs: i64, rhs: f64) -> CmpResult
native impl const fn compare_(lhs: f64, rhs: i64) -> CmpResult

# OPS-4, OPS-6: the conversions that cannot fail. A list of structs to a
# list of their parent is not declared here.
native impl const fn convert(value: i64) -> f64
native impl const fn convert(value: i64) -> bool
native impl const fn convert(value: i64) -> str
native impl const fn convert(value: f64) -> bool
native impl const fn convert(value: f64) -> str
native impl const fn convert(value: bool) -> i64
native impl const fn convert(value: bool) -> f64
native impl const fn convert(value: bool) -> str
native impl const fn convert(value: str) -> bytes
native impl const fn convert(value: date) -> datetime
native impl const fn convert(value: datetime) -> date

# OPS-4, FMT-5: collection parts use their own text conversion, with
# strings quoted and date, time, datetime and duration written as by format.
native impl const fn convert<T>(value: list<T>) -> str
    requires T in {str, date, time, datetime, duration} || convert(T) -> str
native impl const fn convert<T, N>(value: list<T, N>) -> str
    requires T in {str, date, time, datetime, duration} || convert(T) -> str
native impl const fn convert<T>(value: list<T?>) -> str
    requires T in {str, date, time, datetime, duration} || convert(T) -> str
native impl const fn convert<T, N>(value: list<T?, N>) -> str
    requires T in {str, date, time, datetime, duration} || convert(T) -> str
native impl const fn convert<T>(value: set<T>) -> str
    requires T in {str, date, time, datetime, duration} || convert(T) -> str
native impl const fn convert<K, V>(value: dict<K, V>) -> str
    requires (K in {str, date, time, datetime, duration} || convert(K) -> str)
        && (V in {str, date, time, datetime, duration} || convert(V) -> str)
native impl const fn convert<K, V>(value: dict<K, V?>) -> str
    requires (K in {str, date, time, datetime, duration} || convert(K) -> str)
        && (V in {str, date, time, datetime, duration} || convert(V) -> str)

# OPS-5: the Boolean forms. A chain is `and_` or `or_` applied left to right.
native impl const fn and_(lhs: bool, rhs: bool) -> bool
native impl const fn or_(lhs: bool, rhs: bool) -> bool
native impl const fn not_(value: bool) -> bool
native impl const fn all_(values: ...bool) -> bool
native impl const fn any_(values: ...bool) -> bool

# OPS-7, OPS-8: the conversions that can fail. Under `invalid: .error`, the
# default, each returns a `result`; under `.fail` the plain type, and a
# failure escapes. An `f64` to an `i64` takes `rounding` and `nan` too.
native impl const fn convert<const invalid: InvalidPolicy = .error>(
    value: f64,
    rounding: Rounding = .truncate,
    nan: i64? = null,
) -> result<i64, error>
    requires invalid == .error
native impl const fn convert<const invalid: InvalidPolicy>(
    value: f64,
    rounding: Rounding = .truncate,
    nan: i64? = null,
) -> i64
    requires invalid == .fail
native impl const fn convert<const invalid: InvalidPolicy = .error>(value: str) -> result<i64, error>
    requires invalid == .error
native impl const fn convert<const invalid: InvalidPolicy>(value: str) -> i64
    requires invalid == .fail
native impl const fn convert<const invalid: InvalidPolicy = .error>(value: str) -> result<f64, error>
    requires invalid == .error
native impl const fn convert<const invalid: InvalidPolicy>(value: str) -> f64
    requires invalid == .fail
native impl const fn convert<const invalid: InvalidPolicy = .error>(value: str) -> result<bool, error>
    requires invalid == .error
native impl const fn convert<const invalid: InvalidPolicy>(value: str) -> bool
    requires invalid == .fail
native impl const fn convert<const invalid: InvalidPolicy = .error>(value: bytes) -> result<str, error>
    requires invalid == .error
native impl const fn convert<const invalid: InvalidPolicy>(value: bytes) -> str
    requires invalid == .fail

# TYPE-7, OPS-4, OPS-6: an enum's name and number are explicit conversions.
native impl const fn convert<E>(value: E) -> str
    requires E in enum
native impl const fn convert<E>(value: E) -> i64
    requires E in enum

# TYPE-7, OPS-7, OPS-8: only a member's number converts to that enum.
native impl const fn convert<E, const invalid: InvalidPolicy = .error>(value: i64) -> result<E, error>
    requires E in enum && invalid == .error
native impl const fn convert<E, const invalid: InvalidPolicy>(value: i64) -> E
    requires E in enum && invalid == .fail
