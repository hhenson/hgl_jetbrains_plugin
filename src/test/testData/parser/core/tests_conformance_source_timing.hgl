module conformance part source_timing

fn time_before_each_delay() -> datetime {
    inject clock
    {
        yield 2us: clock.evaluation_time
        yield 3us: clock.evaluation_time
    }
}

/**
Under the proposed yield timing, a delayed publication carries the value
computed before suspension. The second delay starts when the source resumes.

:Rules: SOURCE-2, SOURCE-3, CAP-3
:Status: proposed
*/
test a_delayed_yield_keeps_its_payload_until_it_wakes {
    let start_time = @2026-01-05T09:30:00Z
    assert eval(time_before_each_delay(), RunConfig(start: start_time)) ==
        [_, _, start_time, _, _, start_time + 2us]
}

fn absolute_yields(const first: datetime, const second: datetime) -> i64 {
    yield first: 10
    yield second: 20
}

/**
Under the proposed timing, absolute targets before the run start are skipped.
A target exactly at the start publishes there, and a later target publishes
at its stated time.

:Rules: SOURCE-2, SOURCE-3
:Status: proposed
*/
test absolute_targets_before_at_and_after_start {
    let opening = @2026-01-05T09:30:00Z
    let times = RunConfig(start: opening)
    assert eval(absolute_yields(first: opening - 2us, second: opening), times) == [20]
    assert eval(absolute_yields(first: opening, second: opening + 2us), times) ==
        [10, _, 20]
}

/**
The proposed target order is strictly increasing even across skipped targets.
Both targets start in the past. Equal or decreasing times still fail.

:Rules: SOURCE-3
:Status: proposed
*/
test skipped_targets_still_establish_source_order {
    let opening = @2026-01-05T09:30:00Z
    let past = opening - 2us
    let times = RunConfig(start: opening)
    assert eval(absolute_yields(first: past, second: past + 1us), times) == []
    assert raises("yield.non_increasing_time") {
        eval(absolute_yields(first: past, second: past), times)
    }
    assert raises("yield.non_increasing_time") {
        eval(absolute_yields(first: past, second: past - 1us), times)
    }
}

fn delayed_quotient(const delay: duration, const divisor: i64) -> i64 {
    yield delay: 12 // divisor
}

/**
The proposed yield order evaluates the payload before validating its target.
With the same negative delay, a failing payload reports its own error first.

:Rules: SOURCE-2
:Status: proposed
*/
test yield_payload_failure_precedes_target_validation {
    assert raises("yield.negative_duration") {
        eval(delayed_quotient(delay: -1us, divisor: 3))
    }
    assert raises("numeric.division_by_zero") {
        eval(delayed_quotient(delay: -1us, divisor: 0))
    }
}

fn finish_or_resume(const finish_early: bool) -> i64 {
    inject clock
    {
        let opening = clock.evaluation_time
        yield 2us: 10
        if finish_early { return }
        yield opening + 4us: 20
    }
}

/**
Under the proposed source lifecycle, a bare return ends the source.
A continuing source keeps its local opening time across suspension, so its
second publication falls four steps after opening.

:Rules: SOURCE-2, SOURCE-3, SOURCE-4, CAP-3
:Status: proposed
*/
test a_resumed_source_keeps_its_locals_until_it_returns {
    assert eval(finish_or_resume(finish_early: false)) == [_, _, 10, _, 20]
    assert eval(finish_or_resume(finish_early: true)) == [_, _, 10]
}
