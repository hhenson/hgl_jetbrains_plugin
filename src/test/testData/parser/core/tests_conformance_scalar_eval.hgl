module conformance part scalar_eval

fn pass_i64(value: i64) -> i64 {
    when { return delta_value(value) }
}

fn pass_bool(value: bool) -> bool {
    when { return delta_value(value) }
}

fn pass_str(value: str) -> str {
    when { return delta_value(value) }
}

# Publishes the number of admitted evaluations in this run.
fn count_publications(value: i64) -> i64 {
    state count: i64 = 0
    when {
        count += 1
        return count
    }
}

/**
Each publication wakes an admitted node, even when its value repeats.
The counter advances once per tick. A relay forwards the delta for each one.

Rules:
    END-2, END-3, END-5, CEVAL-3

Status:
    agreed
*/
test replay_preserves_equal_ticks {
    assert eval count_publications(value: [7, _, 7, 7, _]) ==
        [1, _, 2, 3]
    assert eval pass_i64(value: [7, _, 7, 9]) == [7, _, 7, 9]
}

/**
Zero, false and empty text each publish a value and wake their consumers.
The silent slot separates two identical publications of each value.

Rules:
    END-1, END-2, CEVAL-3, TST-9

Status:
    agreed
*/
test zero_false_and_empty_text_are_present {
    assert eval pass_i64(value: [0, _, 0]) == [0, _, 0]
    assert eval pass_bool(value: [false, _, false, true]) == [false, _, false, true]
    assert eval pass_str(value: ["", _, "", "a"]) == ["", _, "", "a"]
}

/**
Each run starts with fresh node state and a fresh recording.
The counter starts at one again after an intervening empty run.

Rules:
    TIME-5, CEVAL-5

Status:
    agreed
*/
test runs_are_independent {
    assert eval count_publications(value: [7, _, 7]) == [1, _, 2]
    assert eval count_publications(value: []) == []
    assert eval count_publications(value: [7, _, 7]) == [1, _, 2]
}
