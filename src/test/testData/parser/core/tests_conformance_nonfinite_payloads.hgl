module conformance part nonfinite_payloads

# The numerator selects one of three IEEE payloads. The observer returns a
# label so the test can describe a NaN without comparing two recorded NaNs.
fn nonfinite_value(numerator: f64) -> f64 {
    when { return numerator /{zero: .ieee} 0.0 }
}

fn name_float(watched: f64, probe: bool) -> str {
    when modified(probe) && valid([]) {
        if valid(watched) {
            if watched != watched { return "NaN" }
            let infinity: f64 = 1.0 /{zero: .ieee} 0.0
            if watched == infinity { return "+infinity" }
            if watched == -infinity { return "-infinity" }
            return "finite"
        }
        return "invalid"
    }
}

fn sample_float(numerator: f64, probe: bool) -> str =>
    name_float(nonfinite_value(numerator), probe)

/**
NaN and either infinity are valid scalar payloads and retain their values through silence.
The first probe sees an invalid endpoint. Later probes distinguish each special
value, including the NaN read again during a gap.

:Rules: END-1, TIME-1
:Status: agreed
*/
test nonfinite_values_are_valid_payloads {
    assert eval sample_float(
        numerator: [        _,    0.0,     _,         1.0,        -1.0],
        probe:     [     true,   true,  true,        true,        true],
    )  ==          ["invalid",  "NaN", "NaN", "+infinity", "-infinity"]
}
