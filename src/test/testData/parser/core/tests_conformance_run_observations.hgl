module conformance part run_observations

fn counter_difference(left: i64, right: i64) -> i64 =>
    count_publications(left) - count_publications(right)

/**
Two instances of a stateful node in the same graph keep separate histories.
Each counter advances only on its own input. The left leads by two
publications before the right catches up and overtakes it.

:Rules: TIME-2, TIME-6
:Status: agreed
*/
test two_counters_in_one_graph_keep_separate_state {
    assert eval(counter_difference(
        left:  [1, 2,  3, _,  _,  _],
        right: [_, 10, _, 20, 30, 40])) ==
               [_, 1,  2, 1,  0,  -1]
}

fn first_sample_difference(left: i64, right: i64) -> i64 =>
    first_gathered(right) - first_gathered(left)

/**
Each node starts with its own mutable cache, even when both use an empty list.
Each instance appends its inputs and reports its first entry. If they
shared the list, both first entries would be 4.

:Rules: TIME-6
:Status: agreed
*/
test two_instances_start_with_independent_cache_lists {
    assert eval(first_sample_difference(
        left:  [4, _,  8, _],
        right: [_, 30, _, 40])) ==
               [_, 26, 26, 26]
}

fn total_from_initial_state(value: i64, const seed: i64) -> i64 {
    state opening: i64 = seed
    cache total: i64 = opening * 2
    start { opening = 100 }
    when {
        total += value
        return total
    }
}

/**
A cache initializer can read node state before the start hook changes it.
Two runs seed the state differently. Each cache begins at twice that
run's seed and accumulates both inputs.

:Rules: TIME-5, TIME-6, CRUN-1
:Status: agreed
*/
test a_cache_is_initialized_from_state_before_start {
    assert eval(total_from_initial_state(value: [1, 2], seed: 3)) == [7, 9]
    assert eval(total_from_initial_state(value: [1, 2], seed: 5)) == [11, 13]
}

/**
Completing a second run leaves the first run's recording intact.
Read both results only after the second run has stopped. Each run keeps
its own values and publication times.

:Rules: CRUN-1, CRUN-8, CEVAL-5
:Status: agreed
*/
test an_earlier_recording_survives_a_second_run {
    let monday = @2026-01-05T09:30:00Z
    let tuesday = @2026-01-06T09:30:00Z
    let first = eval(pass_i64(value: [7, _, 7]), RunConfig(start: monday))
    let second = eval(pass_i64(value: [_, 9]), RunConfig(start: tuesday))

    assert recorded_ticks(first) == [(monday, 7), (monday + 2us, 7)]
    assert recorded_ticks(second) == [(tuesday + 1us, 9)]
}

fn divide_on_start(value: i64, const divisor: i64) -> i64 {
    state scale: i64 = 0
    start { scale = 12 // divisor }
    when { return value * scale }
}

/**
A start failure escapes eval even when the inputs schedule no evaluations.
The successful run makes the start hook's scale visible in the output.

:Rules: TIME-5, CRUN-1, CRUN-6, CEVAL-6
:Status: agreed
*/
test start_failures_escape_an_empty_run {
    assert eval(divide_on_start(value: [2], divisor: 3)) == [8]
    assert raises("numeric.division_by_zero") {
        eval(divide_on_start(value: [], divisor: 0))
    }
}
