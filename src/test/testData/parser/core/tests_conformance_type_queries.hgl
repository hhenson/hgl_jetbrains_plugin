module conformance part type_queries

fn cold_type_label(value: i64, probe: bool) -> str {
    state label: Type = type(value)
    start { let known = type(value) }
    when valid([]) { return convert<str>(label) }
}

fn graph_type_label(value: i64) -> str => convert<str>(type(value))

/**
An input's type is available at start and in a handler without admitting its payload.
Only the probe publishes at every step; the silent value input is never read.

Rules:
    TYPE-18, FMT-5

Status:
    agreed
*/
test cold_node_type_query {
    assert eval cold_type_label(value: [_, 7, _], probe: [true, true, true]) == ["i64", "i64", "i64"]
}

fn cold_type_assignment(value: i64) -> i64 {
    var x: i64
    let known = type({
        x = value
        x
    })
    x = 1
    return x
}

fn unwired_type_operand(value: i64) -> i64 {
    start { assert false }
    when valid(value) { return value }
}

fn unwired_type_label() -> str => convert<str>(type(unwired_type_operand(1)))

/**
A graph's type query produces a constant without evaluating the input's payload.
The input's later publication adds no publication to this constant graph.
An assignment inside a cold operand does not set the surrounding var's category.
A queried node is not wired: its failing start hook is never run.

Rules:
    TYPE-18, FMT-5

Status:
    agreed
*/
test cold_graph_type_query {
    assert eval graph_type_label(value: [_, 7, _]) == ["i64"]
    assert eval cold_type_assignment(value: [2, 3]) == [1]
    assert eval unwired_type_label() == ["i64"]
}
