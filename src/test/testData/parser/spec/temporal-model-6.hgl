module examples.references

fn pick(flag: bool, ref low: f64, ref high: f64) -> ref f64 {
    when modified(flag) {
        if flag { return high }
        return low
    }
}

fn follow(value: f64) -> f64 {
    when { return value }
}

fn picked(flag: bool, bid: f64, ask: f64) -> f64 =>
    follow(pick(flag, bid, ask))
