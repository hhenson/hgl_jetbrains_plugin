operator each_wanted<K, R, ...Ps, ...As, const key: str = "key">{
    const strict: bool = true,
    keys: set<K>? = null,
}(
    f: fn(...{Ps}) -> R,
    args: ...{As for f without key},
) -> dict<K, R>
    requires each arg in arg_keys(As) {
        As[arg] == Ps[arg] || As[arg] == dict<K, Ps[arg]>
    }
